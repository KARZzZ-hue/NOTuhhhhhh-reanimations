-- Backgrounds inside the main GUI window
----------------------------------------------------------------
local function injectAsciiBackground()
	local roots = {CoreGui}
	local okH, hid = pcall(function() return (gethui and gethui()) or (get_hidden_gui and get_hidden_gui()) end)
	if okH and hid then table.insert(roots, 1, hid) end

	-- find the window's content area (the Uhhhhhh UI starts a while after launch)
	local content
	local deadline = os.clock() + 300
	while not content and os.clock() < deadline do
		for _, root in ipairs(roots) do
			for _, g in ipairs(root:GetChildren()) do
				if g:IsA("ScreenGui") and g.DisplayOrder == 2147483647 and g ~= introGui then
					for _, d in ipairs(g:GetDescendants()) do
						if d:IsA("Frame") and d.ClipsDescendants
							and d.Position == UDim2.new(0, 0, 0, 30)
							and d.Size == UDim2.new(1, 0, 1, -35) then
							content = d
							break
						end
					end
				end
				if content then break end
			end
			if content then break end
		end
		if not content then task.wait(0.25) end
	end
	if not content then return end

	local W, H = content.AbsoluteSize.X, content.AbsoluteSize.Y
	if W < 50 then W = 360 end
	if H < 50 then H = 205 end

	-- logo watermark for the plasma: the sparkle logo in ascii art
	local logo = LOGO_SMALL
	local logoCols, logoRows = #logo[1], #logo

	local SIZE = 8
	local cw, lh = asciiMetrics(SIZE)
	local cols, rows = math.floor(W / cw), math.floor(H / lh)
	while (cols < logoCols + 2 or rows < logoRows + 2) and SIZE > 5 do
		SIZE -= 1
		cw, lh = asciiMetrics(SIZE)
		cols, rows = math.floor(W / cw), math.floor(H / lh)
	end

	local function mkLabel(z, trans)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.BorderSizePixel = 0
		l.Position = UDim2.fromOffset(0, 0)
		l.Size = UDim2.fromScale(1, 1)
		l.Font = ASCII_FONT
		l.TextSize = SIZE
		l.TextColor3 = Color3.new(1, 1, 1)
		l.TextTransparency = trans
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextYAlignment = Enum.TextYAlignment.Top
		l.TextWrapped = false
		l.ZIndex = z
		l.Interactable = false
		l.Text = ""
		l.Visible = false
		l.Parent = content
		return l
	end
	local plasma = mkLabel(-2, 0.88)
	local logoLabel = mkLabel(-1, 0.6)
	local sceneLabel = mkLabel(-2, BG.cfg.SceneAlpha)

	local row0 = math.max(0, math.floor((rows - logoRows) / 2))
	local col0 = math.max(0, math.floor((cols - logoCols) / 2))
	local logoLines = table.create(rows)
	for y = 1, rows do
		local r = y - 1 - row0
		if r >= 0 and r < logoRows then
			logoLines[y] = string.rep(" ", col0) .. logo[r + 1]
		else
			logoLines[y] = ""
		end
	end
	logoLabel.Text = table.concat(logoLines, "\n")

	-- keep the plasma out of the logo's shape (plus a 1 cell margin) so the logo stays clean
	local blank = {}
	for r = 0, logoRows - 1 do
		local line = logo[r + 1]
		for c = 0, logoCols - 1 do
			if line:sub(c + 1, c + 1) ~= " " then
				for dy = -1, 1 do
					for dx = -1, 1 do
						blank[(row0 + r + 1 + dy) * 256 + (col0 + c + 1 + dx)] = true
					end
				end
			end
		end
	end

	-- ascii art from a .txt file
	local textBg = Instance.new("TextLabel")
	textBg.BackgroundTransparency = 1
	textBg.BorderSizePixel = 0
	textBg.AnchorPoint = Vector2.new(0.5, 0.5)
	textBg.Position = UDim2.fromScale(0.5, 0.5)
	textBg.Size = UDim2.fromOffset(W, H)
	textBg.Font = ASCII_FONT
	textBg.TextSize = 8
	textBg.TextColor3 = Color3.new(1, 1, 1)
	textBg.TextTransparency = 0.55
	textBg.TextXAlignment = Enum.TextXAlignment.Left
	textBg.TextYAlignment = Enum.TextYAlignment.Top
	textBg.TextWrapped = false
	textBg.ZIndex = -2
	textBg.Interactable = false
	textBg.Visible = false
	textBg.Text = ""
	textBg.Parent = content

	-- tiled starburst pattern that slowly drifts diagonally
	local patternBg = Instance.new("ImageLabel")
	patternBg.BackgroundTransparency = 1
	patternBg.BorderSizePixel = 0
	patternBg.Position = UDim2.fromOffset(0, 0)
	patternBg.ScaleType = Enum.ScaleType.Tile
	patternBg.ImageColor3 = Color3.new(1, 1, 1)
	patternBg.ZIndex = -2
	patternBg.Interactable = false
	patternBg.Visible = false
	patternBg.Parent = content
	local lastTile = -1
	local function updatePattern(cfg)
		local tile = math.max(16, math.floor(cfg.PatternTile))
		if tile ~= lastTile then
			lastTile = tile
			patternBg.Size = UDim2.new(1, tile, 1, tile)
			patternBg.TileSize = UDim2.fromOffset(tile, tile)
		end
		patternBg.ImageTransparency = cfg.PatternAlpha
		local off = (os.clock() * cfg.PatternSpeed) % tile
		patternBg.Position = UDim2.fromOffset(-off, -off)
	end

	-- a picture from the backgrounds folder
	local imageBg = Instance.new("ImageLabel")
	imageBg.BackgroundTransparency = 1
	imageBg.BorderSizePixel = 0
	imageBg.Size = UDim2.fromScale(1, 1)
	imageBg.ScaleType = Enum.ScaleType.Crop
	imageBg.ImageTransparency = 0.45
	imageBg.ZIndex = -2
	imageBg.Interactable = false
	imageBg.Visible = false
	imageBg.Parent = content

	-- fit a text file's ascii art into the window and centre it
	local function showText(txt)
		txt = txt:gsub("\r\n", "\n"):gsub("\r", "\n"):gsub("\t", "    ")
		local lines, maxc = {}, 1
		for line in (txt .. "\n"):gmatch("(.-)\n") do
			if #lines >= 200 then break end
			if #line > 300 then line = line:sub(1, 300) end
			lines[#lines + 1] = line
			maxc = math.max(maxc, utf8.len(line) or #line)
		end
		while #lines > 1 and lines[#lines]:match("^%s*$") do
			lines[#lines] = nil
		end
		local cw20, lh20 = asciiMetrics(20)
		local fit = math.min(W * 0.96 / (maxc * cw20 / 20), H * 0.96 / (#lines * lh20 / 20))
		local tsize = math.clamp(math.floor(fit), 3, 24)
		local cwt, lht = asciiMetrics(tsize)
		local body = table.concat(lines, "\n")
		if #body > 15000 then body = body:sub(1, 15000) end
		textBg.TextSize = tsize
		textBg.Size = UDim2.fromOffset(math.ceil(maxc * cwt) + 4, math.ceil(#lines * lht))
		textBg.Text = body
	end

	-- the animated scenes
	local sceneDef, sceneState, sceneActive = nil, nil, false

	local function applyBackground()
		local name = BG.current
		local kind = "pattern"
		local entry = nil
		if name == BG_NONE then
			kind = "none"
		elseif name == BG_PLASMA then
			kind = "plasma"
		elseif SCENES[name] then
			kind = "scene"
		elseif name ~= BG_PATTERN then
			entry = BG.byName[name]
			if entry then kind = entry.kind end
		end

		sceneActive = false
		sceneLabel.Text = ""
		if kind == "pattern" then
			local asset = patternAsset()
			if asset then
				patternBg.Image = asset
			else
				kind = "plasma"
			end
		elseif kind == "scene" then
			sceneDef = SCENES[name]
			sceneState = sceneDef.new(cols, rows)
			sceneActive = true
		elseif kind == "text" then
			local ok, txt = pcall(readfile, entry.path)
			if ok and type(txt) == "string" then
				showText(txt)
			else
				kind = "plasma"
			end
		elseif kind == "image" then
			local ok, asset = pcall(function() return getAsset(entry.path) end)
			if ok and asset and asset ~= "" then
				imageBg.Image = asset
			else
				kind = "plasma"
			end
		end

		plasma.Visible = kind == "plasma"
		logoLabel.Visible = kind == "plasma"
		sceneLabel.Visible = kind == "scene"
		textBg.Visible = kind == "text"
		imageBg.Visible = kind == "image"
		patternBg.Visible = kind == "pattern"
	end
	BG.apply = applyBackground
	BG.scan(false)
	applyBackground()

	-- animation loop + theme colours
	local RAMP = " .:-=+*#"
	local nramp = #RAMP
	local mx, my = cols / 2, rows / 2
	local plasmaAcc, sceneAcc = 0, 0
	local ref, refT, mainPage = nil, 0, nil
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if not plasma.Parent then
			conn:Disconnect()
			return
		end

		-- take the text colour from the UI (light themes get dark ascii instead of white)
		-- and make only the main page see-through; the other pages stack and must stay solid
		if not ref then
			refT += dt
			if refT > 1 then
				refT = 0
				for _, d in ipairs(content:GetDescendants()) do
					if d:IsA("TextLabel") and d.Text:find("Back to cool scene", 1, true) then
						ref = d
						mainPage = d:FindFirstAncestorWhichIsA("ScrollingFrame")
						break
					end
				end
			end
		else
			local c = ref.TextColor3
			plasma.TextColor3 = c
			logoLabel.TextColor3 = c
			sceneLabel.TextColor3 = c
			textBg.TextColor3 = c
			patternBg.ImageColor3 = c
			if mainPage and mainPage.BackgroundTransparency ~= 1 then
				mainPage.BackgroundTransparency = 1
			end
		end

		if not content.Visible then return end
		local cfg = BG.cfg

		if patternBg.Visible then
			updatePattern(cfg)
		end

		if sceneActive then
			sceneAcc += dt
			if sceneAcc >= 1 / math.max(1, cfg.SceneFPS) then
				local elapsed = sceneAcc
				sceneAcc = 0
				sceneLabel.TextTransparency = cfg.SceneAlpha
				local okL, loud = pcall(musicLoudness)
				local ok, txt = pcall(sceneDef.render, sceneState, os.clock(), elapsed, okL and loud or 0)
				if ok and type(txt) == "string" then sceneLabel.Text = txt end
			end
		end

		if plasma.Visible then
			plasmaAcc += dt
			if plasmaAcc >= 1 / 12 then
				plasmaAcc = 0
				local t = os.clock() * 0.9
				local lines = table.create(rows)
				for y = 1, rows do
					local row = table.create(cols)
					for x = 1, cols do
						local ch = " "
						if not blank[y * 256 + x] then
							local v = math.sin(x * 0.21 + t)
								+ math.sin(y * 0.38 - t * 1.3)
								+ math.sin((x + y) * 0.14 + t * 0.7)
								+ math.sin(math.sqrt((x - mx) ^ 2 + ((y - my) * 2) ^ 2) * 0.22 - t * 1.1)
							local idx = math.clamp(math.floor((v + 4) / 8 * nramp) + 1, 1, nramp)
							ch = RAMP:sub(idx, idx)
						end
						row[x] = ch
					end
					lines[y] = table.concat(row)
				end
				plasma.Text = table.concat(lines, "\n")
				logoLabel.TextTransparency = 0.62 + math.sin(os.clock() * 2) * 0.08
			end
		end
	end)
end

