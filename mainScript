	UI.CreateButton(configPage, "Dancing configs", 20).Activated:Connect(function() showPage(dancePage) end)

	----------------------------------------------------------------
	-- moveset configs: trail
	----------------------------------------------------------------
	local trailState = {objs = {}, parts = {}, dirty = true}
	local function dirty() trailState.dirty = true end

	backButton(movesetPage, configPage)
	UI.CreateSeparator(movesetPage)
	UI.CreateText(movesetPage, "Trail: a ribbon that follows your reanimated body wherever you put it.", 13, Enum.TextXAlignment.Left)
	UI.CreateSwitch(movesetPage, "Trail", T.Enabled).Changed:Connect(function(v) T.Enabled = v dirty() end)
	UI.CreateDropdown(movesetPage, "Location", TRAIL_LOCATIONS, indexOf(TRAIL_LOCATIONS, T.Location)).Changed:Connect(function(i)
		T.Location = TRAIL_LOCATIONS[i] or "Torso"
		dirty()
	end)
	local ORIENTATIONS = {"Vertical", "Horizontal"}
	UI.CreateDropdown(movesetPage, "Direction", ORIENTATIONS, indexOf(ORIENTATIONS, T.Orientation)).Changed:Connect(function(i)
		T.Orientation = ORIENTATIONS[i] or "Vertical"
		dirty()
	end)
	UI.CreateSeparator(movesetPage)
	UI.CreateSwitch(movesetPage, "Rainbow", T.Rainbow).Changed:Connect(function(v) T.Rainbow = v dirty() end)
	UI.CreateSlider(movesetPage, "Red", T.R, 0, 255, 1).Changed:Connect(function(v) T.R = math.floor(v + 0.5) dirty() end)
	UI.CreateSlider(movesetPage, "Green", T.G, 0, 255, 1).Changed:Connect(function(v) T.G = math.floor(v + 0.5) dirty() end)
	UI.CreateSlider(movesetPage, "Blue", T.B, 0, 255, 1).Changed:Connect(function(v) T.B = math.floor(v + 0.5) dirty() end)
	UI.CreateSeparator(movesetPage)
	UI.CreateSlider(movesetPage, "Lifetime (sec)", T.Lifetime, 0.1, 3, 0.1).Changed:Connect(function(v) T.Lifetime = round2(v) dirty() end)
	UI.CreateSlider(movesetPage, "Width", T.Width, 0.2, 6, 0.1).Changed:Connect(function(v) T.Width = round2(v) dirty() end)
	UI.CreateSlider(movesetPage, "Transparency", T.Transparency, 0, 1, 0.05).Changed:Connect(function(v) T.Transparency = round2(v) dirty() end)
	UI.CreateSlider(movesetPage, "Glow", T.LightEmission, 0, 1, 0.05).Changed:Connect(function(v) T.LightEmission = round2(v) dirty() end)
	UI.CreateSwitch(movesetPage, "Face camera", T.FaceCamera).Changed:Connect(function(v) T.FaceCamera = v dirty() end)

	local function clearTrails()
		for _, o in ipairs(trailState.objs) do
			pcall(function()
				o.trail:Destroy()
				o.a0:Destroy()
				o.a1:Destroy()
			end)
		end
		trailState.objs = {}
		trailState.parts = {}
	end

	local function buildTrails(parts)
		clearTrails()
		local half = T.Width / 2
		for _, part in ipairs(parts) do
			local a0 = Instance.new("Attachment")
			local a1 = Instance.new("Attachment")
			a0.Name, a1.Name = "NOTTrailA0", "NOTTrailA1"
			if T.Orientation == "Horizontal" then
				a0.Position, a1.Position = Vector3.new(half, 0, 0), Vector3.new(-half, 0, 0)
			else
				a0.Position, a1.Position = Vector3.new(0, half, 0), Vector3.new(0, -half, 0)
			end
			a0.Parent, a1.Parent = part, part
			local tr = Instance.new("Trail")
			tr.Name = "NOTTrail"
			tr.Attachment0, tr.Attachment1 = a0, a1
			tr.Lifetime = T.Lifetime
			tr.LightEmission = T.LightEmission
			tr.FaceCamera = T.FaceCamera
			tr.MinLength = 0.05
			tr.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, T.Transparency),
				NumberSequenceKeypoint.new(1, 1),
			})
			tr.Color = ColorSequence.new(Color3.fromRGB(T.R, T.G, T.B))
			tr.Parent = part
			table.insert(trailState.objs, {trail = tr, a0 = a0, a1 = a1})
		end
		trailState.parts = parts
		trailState.dirty = false
	end

	----------------------------------------------------------------
	-- dancing configs: ghost fills
	----------------------------------------------------------------
	local TRIGGERS = {"Dancing (auto)", "Always"}
	backButton(dancePage, configPage)
	UI.CreateSeparator(dancePage)
	UI.CreateText(dancePage, "Ghosts: while you dance, solid copies of your avatar stay where they spawned and fade out. Off until you turn it on.", 13, Enum.TextXAlignment.Left)
	UI.CreateSwitch(dancePage, "Dancing ghosts", D.Enabled).Changed:Connect(function(v) D.Enabled = v end)
	UI.CreateDropdown(dancePage, "Active when", TRIGGERS, indexOf(TRIGGERS, D.Trigger)).Changed:Connect(function(i)
		D.Trigger = TRIGGERS[i] or TRIGGERS[1]
	end)
	UI.CreateText(dancePage, "Dancing (auto) = dance music or an emote is playing. Pick Always to test it or for dances without music.", 11, Enum.TextXAlignment.Left)
	UI.CreateSeparator(dancePage)
	UI.CreateSlider(dancePage, "Spawn every (sec)", D.Interval, 0.05, 2, 0.05).Changed:Connect(function(v) D.Interval = math.max(0.05, round2(v)) end)
	UI.CreateSlider(dancePage, "Fade out (sec)", D.Fade, 0.1, 3, 0.1).Changed:Connect(function(v) D.Fade = math.max(0.1, round2(v)) end)
	UI.CreateSlider(dancePage, "Start transparency", D.StartTransparency, 0, 0.9, 0.05).Changed:Connect(function(v) D.StartTransparency = round2(v) end)
	UI.CreateSlider(dancePage, "Max ghosts", D.MaxGhosts, 1, 40, 1).Changed:Connect(function(v) D.MaxGhosts = math.floor(v + 0.5) end)
	UI.CreateSlider(dancePage, "Expand while fading", D.Expand, 0, 1, 0.05).Changed:Connect(function(v) D.Expand = round2(v) end)
	UI.CreateDropdown(dancePage, "Material", GHOST_MATERIALS, indexOf(GHOST_MATERIALS, D.Material)).Changed:Connect(function(i)
		D.Material = GHOST_MATERIALS[i] or "Neon"
	end)
	UI.CreateSeparator(dancePage)
	UI.CreateSwitch(dancePage, "Rainbow", D.Rainbow).Changed:Connect(function(v) D.Rainbow = v end)
	UI.CreateSlider(dancePage, "Red", D.R, 0, 255, 1).Changed:Connect(function(v) D.R = math.floor(v + 0.5) end)
	UI.CreateSlider(dancePage, "Green", D.G, 0, 255, 1).Changed:Connect(function(v) D.G = math.floor(v + 0.5) end)
	UI.CreateSlider(dancePage, "Blue", D.B, 0, 255, 1).Changed:Connect(function(v) D.B = math.floor(v + 0.5) end)

	local ghosts = {}
	local function clearGhosts()
		for _, g in ipairs(ghosts) do
			pcall(function() g:Destroy() end)
		end
		ghosts = {}
	end

	local function isDancing()
		if D.Trigger == "Always" then return true end
		if UISound and UISound.DanceMusic and UISound.DanceMusic.IsPlaying then return true end
		for _, m in ipairs(bodyModels()) do
			local hum = m:FindFirstChildOfClass("Humanoid")
			local animator = hum and hum:FindFirstChildOfClass("Animator")
			if animator then
				for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
					local pr = track.Priority.Name
					if pr == "Action" or pr == "Action2" or pr == "Action3" or pr == "Action4" then
						return true
					end
				end
			end
		end
		return false
	end

	-- a plain solid copy of one body part (keeps meshes, drops textures, faces, welds, scripts...)
	local function ghostOf(part)
		local okC, c = pcall(function() return part:Clone() end)
		if not okC or not c then
			c = Instance.new("Part")
			c.Size = part.Size
		end
		for _, ch in ipairs(c:GetChildren()) do
			if ch:IsA("DataModelMesh") then
				pcall(function() ch.TextureId = "" end)
			else
				ch:Destroy()
			end
		end
		if c:IsA("MeshPart") then
			pcall(function() c.TextureID = "" end)
		end
		c.Anchored = true
		c.CanCollide = false
		c.CanQuery = false
		c.CanTouch = false
		c.Massless = true
		c.CastShadow = false
		c.CFrame = part.CFrame
		return c
	end

	local function spawnGhost()
		local parts = visibleBodyParts()
		if #parts == 0 then return end
		local folder = Instance.new("Folder")
		folder.Name = "NOTGhost"
		local color = D.Rainbow and Color3.fromHSV((os.clock() * 0.4) % 1, 1, 1) or Color3.fromRGB(D.R, D.G, D.B)
		local material = Enum.Material.Neon
		pcall(function() material = Enum.Material[D.Material] end)
		local fade = math.max(0.1, D.Fade)
		for i, part in ipairs(parts) do
			if i > 80 then break end
			local c = ghostOf(part)
			c.Color = color
			c.Material = material
			c.Transparency = D.StartTransparency
			c.Parent = folder
			local goal = {Transparency = 1}
			if D.Expand > 0 then goal.Size = c.Size * (1 + D.Expand) end
			TweenService:Create(c, TweenInfo.new(fade, Enum.EasingStyle.Linear), goal):Play()
		end
		folder.Parent = workspace.CurrentCamera or workspace
		table.insert(ghosts, folder)
		task.delay(fade + 0.2, function() folder:Destroy() end)
		for i = #ghosts, 1, -1 do
			if not ghosts[i].Parent then table.remove(ghosts, i) end
		end
		while #ghosts > D.MaxGhosts do
			local old = table.remove(ghosts, 1)
			pcall(function() old:Destroy() end)
		end
	end

	----------------------------------------------------------------
	-- run both effects
	----------------------------------------------------------------
	local trailAcc, ghostAcc = 0, 0
	local function step(dt)
		-- trail
		if T.Enabled then
			trailAcc += dt
			if trailAcc >= 0.25 or trailState.dirty then
				trailAcc = 0
				local parts = resolveTrailParts(T.Location)
				local same = (not trailState.dirty) and #parts == #trailState.parts
				if same then
					for i, p in ipairs(parts) do
						if trailState.parts[i] ~= p or not p.Parent then
							same = false
							break
						end
					end
				end
				if not same then buildTrails(parts) end
			end
			if T.Rainbow then
				local seq = rainbowSequence(os.clock())
				for _, o in ipairs(trailState.objs) do o.trail.Color = seq end
			end
		elseif #trailState.objs > 0 then
			clearTrails()
		end

		-- ghosts
		if D.Enabled then
			ghostAcc += dt
			if ghostAcc >= D.Interval then
				ghostAcc = 0
				if isDancing() then spawnGhost() end
			end
		elseif #ghosts > 0 then
			clearGhosts()
		end
	end
	local warned = false
	RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(step, dt)
		if not ok and not warned then
			warned = true
			warn("[" .. TITLE .. "] config effects error: " .. tostring(err))
		end
	end)

	-- move the "Config" button right under the Store button (found by its text)
	task.spawn(function()
		local deadline = os.clock() + 180
		while os.clock() < deadline and MainPage.Parent do
			for _, d in ipairs(MainPage:GetDescendants()) do
				if d:IsA("TextLabel") and d ~= cfgBtn then
					local plain = d.Text:gsub("<[^>]*>", ""):lower()
					if plain:find("%f[%a]store%f[%A]") then
						local c = d
						while c and c.Parent ~= MainPage do c = c.Parent end
						if c and c ~= cfgContainer then
							cfgContainer.LayoutOrder = c.LayoutOrder + 1
							return
						end
					end
				end
			end
			task.wait(1)
		end
	end)
end

