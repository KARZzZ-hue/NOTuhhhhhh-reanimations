-- character width and line height of the monospace font at a given size
local function asciiMetrics(size)
	local big = Vector2.new(1000, 1000)
	local cw = TextService:GetTextSize("#", size, ASCII_FONT, big).X
	local lh = TextService:GetTextSize("#\n#", size, ASCII_FONT, big).Y / 2
	if cw <= 0 then cw = size * 0.55 end
	if lh <= 0 then lh = size end
	return cw, lh
end

----------------------------------------------------------------
-- Loading screen: a black & white cutscene (letterbox, glowing lines on the beat, captions,
-- the ASCII logo grows in, waves, charges up and explodes into static)
----------------------------------------------------------------
local introGui
local introConns = {}

local function playIntro()
	if INTRO_STYLE == "Off" then return end
	repeat task.wait() until workspace.CurrentCamera
	local vp = workspace.CurrentCamera.ViewportSize
	local cx, cy = vp.X / 2, vp.Y / 2
	local WHITE = Color3.new(1, 1, 1)

	local gui = Instance.new("ScreenGui")
	gui.Name = tostring(math.random(1000000, 9000000))
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 2147483647
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local hidden = (gethui and gethui()) or (get_hidden_gui and get_hidden_gui())
	if not pcall(function() gui.Parent = hidden or CoreGui end) then
		gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	end
	introGui = gui

	local base = Instance.new("Frame")
	base.Size = UDim2.fromScale(1, 1)
	base.BackgroundColor3 = Color3.new(0, 0, 0)
	base.BorderSizePixel = 0
	base.ZIndex = 1
	base.Parent = gui

	-- dim ascii static in the back (it turns into the big static burst when the logo explodes)
	local NSIZE = 12
	local ncw, nlh = asciiMetrics(NSIZE)
	local ncols, nrows = math.ceil(vp.X / ncw) + 1, math.ceil(vp.Y / nlh) + 1
	local NPOOL = "01#:.+*%@=-"
	local pool, densePool = {}, {}
	for i = 1, 40 do
		local r, d = table.create(ncols), table.create(ncols)
		for c = 1, ncols do
			local k = math.random(#NPOOL)
			r[c] = (math.random() < 0.55) and " " or NPOOL:sub(k, k)
			k = math.random(#NPOOL)
			d[c] = (math.random() < 0.08) and " " or NPOOL:sub(k, k)
		end
		pool[i] = table.concat(r)
		densePool[i] = table.concat(d)
	end
	local activePool, noiseRate = pool, 0.05

	local noise = Instance.new("TextLabel")
	noise.BackgroundTransparency = 1
	noise.Size = UDim2.fromScale(1, 1)
	noise.Font = ASCII_FONT
	noise.TextSize = NSIZE
	noise.TextColor3 = WHITE
	noise.TextTransparency = 1
	noise.TextXAlignment = Enum.TextXAlignment.Left
	noise.TextYAlignment = Enum.TextYAlignment.Top
	noise.TextWrapped = false
	noise.ZIndex = 2
	noise.Parent = gui
	TweenService:Create(noise, TweenInfo.new(0.5), {TextTransparency = 0.9}):Play()
	local function tickNoise()
		local lines = table.create(nrows)
		for i = 1, nrows do lines[i] = activePool[math.random(#activePool)] end
		noise.Text = table.concat(lines, "\n")
	end
	tickNoise()
	local nacc = 0
	local noiseConn = RunService.Heartbeat:Connect(function(dt)
		nacc += dt
		if nacc >= noiseRate then
			nacc = 0
			tickNoise()
		end
	end)

	-- everything that shakes lives in here
	local stage = Instance.new("Frame")
	stage.AnchorPoint = Vector2.new(0.5, 0.5)
	stage.Position = UDim2.fromScale(0.5, 0.5)
	stage.Size = UDim2.fromScale(1, 1)
	stage.BackgroundTransparency = 1
	stage.BorderSizePixel = 0
	stage.ZIndex = 3
	stage.Parent = gui
	local camScale = Instance.new("UIScale") -- slow camera push
	camScale.Parent = stage

	local shake = 0
	local shakeConn = RunService.Heartbeat:Connect(function(dt)
		shake *= math.exp(-9 * dt)
		if shake < 0.3 then
			stage.Position = UDim2.fromScale(0.5, 0.5)
		else
			stage.Position = UDim2.new(0.5, (math.random() * 2 - 1) * shake, 0.5, (math.random() * 2 - 1) * shake)
		end
	end)

	-- tap anywhere to skip the intro
	local skipped = false
	local skipBtn = Instance.new("TextButton")
	skipBtn.Size = UDim2.fromScale(1, 1)
	skipBtn.BackgroundTransparency = 1
	skipBtn.Text = ""
	skipBtn.AutoButtonColor = false
	skipBtn.ZIndex = 50
	skipBtn.Parent = gui
	skipBtn.Activated:Connect(function() skipped = true end)

	local skipHint = Instance.new("TextLabel")
	skipHint.AnchorPoint = Vector2.new(1, 1)
	skipHint.Position = UDim2.new(1, -14, 1, -9)
	skipHint.TextXAlignment = Enum.TextXAlignment.Right
	skipHint.Size = UDim2.fromOffset(200, 20)
	skipHint.BackgroundTransparency = 1
	skipHint.Font = ASCII_FONT
	skipHint.TextSize = 14
	skipHint.TextColor3 = WHITE
	skipHint.TextTransparency = 0.6
	skipHint.Text = "[ tap to skip ]"
	skipHint.ZIndex = 51
	skipHint.Parent = gui

	-- the logo root fills the screen; a UIScale on it makes the whole logo "grow into" the screen
	local root = Instance.new("Frame")
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.ZIndex = 3
	root.Parent = stage
	local grow = Instance.new("UIScale")
	grow.Scale = 0.12
	grow.Parent = root

	-- size the logo to the screen (phones too)
	local LOGO = LOGO_BIG
	local LCOLS, LROWS = #LOGO[1], #LOGO
	local TILE_C, TILE_R = 4, 7 -- the logo is cut into tiles of 4 columns x 7 rows
	local SUB = "N O T U H H H H H H   R E A N I M A T I O N S"
	local cw20, lh20 = asciiMetrics(20)
	local cwr, lhr = cw20 / 20, lh20 / 20
	local sizeW = math.floor(vp.X * 0.8 / (LCOLS * cwr))
	local sizeH = math.floor(vp.Y * 0.6 / (LROWS * lhr))
	local size = math.clamp(math.min(sizeW, sizeH), 5, 30)
	local cw, lh = asciiMetrics(size)
	local subSize = math.clamp(math.min(math.floor(vp.X * 0.85 / (#SUB * cwr)), math.floor(size * 1.5)), 7, 30)
	local scw, slh = asciiMetrics(subSize)
	local gap = lh * 2
	local logoH = LROWS * lh
	local logoW = LCOLS * cw
	local subW = #SUB * scw
	local totalH = logoH + gap + slh
	local y0 = cy - totalH / 2
	local bx = cx - logoW / 2
	local waveBase = math.max(5, math.floor(logoH * 0.05))

	local flyers, chunks, subChars = {}, {}, {}
	local function makeFlyer(o)
		local l = Instance.new("TextLabel")
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Size = UDim2.fromOffset(o.w, o.h)
		l.Position = UDim2.fromOffset(o.x, o.y)
		l.BackgroundTransparency = 1
		l.Font = ASCII_FONT
		l.TextSize = o.size
		l.Text = o.text
		l.TextColor3 = WHITE
		l.TextTransparency = 1
		l.TextXAlignment = o.align
		l.TextYAlignment = Enum.TextYAlignment.Top
		l.TextWrapped = false
		l.ZIndex = 3
		l.Parent = root
		local L = {
			label = l, text = o.text, x = o.x, y = o.y, px = o.x, py = o.y,
			vx = 0, vy = 0, rot = 0, vr = 0,
			scr = o.scr, ampMul = o.ampMul, rotMul = o.rotMul,
			ph = o.ph, d = o.d or 0, order = o.order or 0,
		}
		table.insert(flyers, L)
		return L
	end

	-- logo tiles (empty tiles are skipped)
	local ncg, nrg = math.floor(LCOLS / TILE_C), math.floor(LROWS / TILE_R)
	for gr = 1, nrg do
		for gc = 1, ncg do
			local lines, any = {}, false
			for r = (gr - 1) * TILE_R + 1, gr * TILE_R do
				local seg = LOGO[r]:sub((gc - 1) * TILE_C + 1, gc * TILE_C)
				if seg:find("%S") then any = true end
				lines[#lines + 1] = seg
			end
			if any then
				local x = bx + ((gc - 1) * TILE_C + TILE_C / 2) * cw
				local y = y0 + ((gr - 1) * TILE_R + TILE_R / 2) * lh
				local dx = (x - cx) / (logoW / 2)
				local dy = (y - (y0 + logoH / 2)) / (logoH / 2)
				table.insert(chunks, makeFlyer({
					w = TILE_C * cw + 2, h = TILE_R * lh,
					x = x, y = y, size = size,
					text = table.concat(lines, "\n"), align = Enum.TextXAlignment.Left,
					scr = true, ampMul = 1, rotMul = 0,
					ph = (x - cx) / logoW * math.pi * 2 * 1.2,
					d = math.clamp(math.sqrt(dx * dx + dy * dy) / 1.5, 0, 1),
				}))
			end
		end
	end

	-- name under the logo: one label per letter so the wave runs through it too
	local subX0 = cx - subW / 2
	local subY = y0 + logoH + gap + slh / 2
	for i = 1, #SUB do
		local ch = SUB:sub(i, i)
		if ch ~= " " then
			local x = subX0 + (i - 0.5) * scw
			table.insert(subChars, makeFlyer({
				w = scw + 2, h = slh, x = x, y = subY,
				size = subSize, text = ch, align = Enum.TextXAlignment.Center,
				scr = false, ampMul = 0.6, rotMul = 0.6,
				ph = (x - cx) / subW * math.pi * 2 * 1.5, order = i,
			}))
		end
	end

	-- ascii "decode" effect: random characters that resolve into the real art
	local SCR = "#:.+*%@01<>/\\|=-"
	local function scrambled(text, p)
		return (text:gsub("%S", function()
			if math.random() < p then
				local k = math.random(#SCR)
				return SCR:sub(k, k)
			end
		end))
	end

	-- the sine wave: a traveling wave runs left -> right through the logo and the name
	local waving, waveAmp, waveSpeed, jit, scramP = false, 0, 3, 0, 0
	local wt = 0
	local waveConn = RunService.Heartbeat:Connect(function(dt)
		if not waving then return end
		wt += dt * waveSpeed
		for _, L in ipairs(flyers) do
			local amp = waveAmp * L.ampMul
			local x, y = L.x, L.y + math.sin(wt + L.ph) * amp
			if jit > 0 then
				x += (math.random() * 2 - 1) * jit
				y += (math.random() * 2 - 1) * jit
			end
			L.label.Position = UDim2.fromOffset(x, y)
			L.label.Rotation = math.cos(wt + L.ph) * waveAmp * 0.25 * L.rotMul
			if L.scr then
				if scramP > 0 then
					L.label.Text = scrambled(L.text, scramP)
					L.dirty = true
				elseif L.dirty then
					L.label.Text = L.text
					L.dirty = false
				end
			end
		end
	end)

	local function easeOutBack(k)
		local c1 = 1.70158
		local c3 = c1 + 1
		return 1 + c3 * (k - 1) ^ 3 + c1 * (k - 1) ^ 2
	end

	table.insert(introConns, noiseConn)
	table.insert(introConns, shakeConn)
	table.insert(introConns, waveConn)

	----------------------------------------------------------------
	-- cutscene layer: letterbox bars, glowing edge lines that move to the beat,
	-- a REC/timecode strip, typed captions, light sweeps between scenes
	----------------------------------------------------------------
	local BPM = 124 -- the beat the lines move to (the intro has no music, so this is its own metronome)
	local BLACK = Color3.new(0, 0, 0)
	local beatEnv, beatIndex = 0, -1
	local lineBoost = 1
	local barH = math.floor(vp.Y * 0.09)
	local barCur, barTarget = 0, barH
	local edgeA, edgeTarget = 0, 1
	local pulseAmp = REDUCE_FLASHING and 0.4 or 1
	local fxNoisePulse = true
	local captionDone = false
	local introStart = os.clock()
	local TS = (INTRO_STYLE == "Short") and 0.55 or 1

	-- not shaken, above the logo
	local fxRoot = Instance.new("Frame")
	fxRoot.Size = UDim2.fromScale(1, 1)
	fxRoot.BackgroundTransparency = 1
	fxRoot.BorderSizePixel = 0
	fxRoot.ZIndex = 8
	fxRoot.Parent = gui

	local function fxFrame(color, z)
		local f = Instance.new("Frame")
		f.BackgroundColor3 = color
		f.BorderSizePixel = 0
		f.ZIndex = z
		f.Parent = fxRoot
		return f
	end
	local function fxLabel(anchorX, text, align)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Font = ASCII_FONT
		l.TextSize = 13
		l.TextColor3 = WHITE
		l.TextXAlignment = align
		l.AnchorPoint = Vector2.new(anchorX, 0.5)
		l.Size = UDim2.fromOffset(300, 18)
		l.Text = text
		l.ZIndex = 5
		l.Visible = false
		l.Parent = fxRoot
		return l
	end

	-- letterbox bars
	local barTop = fxFrame(BLACK, 1)
	local barBot = fxFrame(BLACK, 1)
	barBot.AnchorPoint = Vector2.new(0, 1)
	barBot.Position = UDim2.fromScale(0, 1)

	-- soft glow bands behind the lines (bright in the middle for top/bottom, bright at the edge for the sides)
	local GLOW = 34
	local function glowBand(rotation, seq)
		local f = fxFrame(WHITE, 2)
		f.BackgroundTransparency = 0.5
		local g = Instance.new("UIGradient")
		g.Rotation = rotation
		g.Transparency = seq
		g.Parent = f
		return f
	end
	local NSK = NumberSequenceKeypoint.new
	local midGlow = NumberSequence.new({NSK(0, 1), NSK(0.5, 0.35), NSK(1, 1)})
	local topGlow = glowBand(90, midGlow)
	local botGlow = glowBand(90, midGlow)
	local leftGlow = glowBand(0, NumberSequence.new({NSK(0, 0.35), NSK(1, 1)}))
	local rightGlow = glowBand(0, NumberSequence.new({NSK(0, 1), NSK(1, 0.35)}))
	leftGlow.Position, leftGlow.Size = UDim2.fromOffset(0, 0), UDim2.new(0, GLOW, 1, 0)
	rightGlow.Position, rightGlow.Size = UDim2.new(1, -GLOW, 0, 0), UDim2.new(0, GLOW, 1, 0)

	-- the bright core lines
	local topLine, botLine = fxFrame(WHITE, 3), fxFrame(WHITE, 3)
	local leftLine, rightLine = fxFrame(WHITE, 3), fxFrame(WHITE, 3)

	-- bright dashes that race along each line and surge on every beat
	local function makeSegments(count, length)
		local list = {}
		for i = 1, count do
			local f = fxFrame(WHITE, 4)
			local s = Instance.new("UIStroke")
			s.Color = WHITE
			s.Thickness = 3
			s.Transparency = 0.65
			s.Parent = f
			local len = math.random(40, 140)
			list[i] = {f = f, stroke = s, len = len, u = math.random() * (length + len), k = 0.7 + math.random() * 0.6}
		end
		return list
	end
	local topSegs, botSegs = makeSegments(6, vp.X), makeSegments(6, vp.X)
	local leftSegs, rightSegs = makeSegments(5, vp.Y), makeSegments(5, vp.Y)

	-- REC light, timecode and captions live in the bars
	local recLabel = fxLabel(0, "[*] REC", Enum.TextXAlignment.Left)
	local timeLabel = fxLabel(1, "00:00:00", Enum.TextXAlignment.Right)
	local captionLabel = fxLabel(0, "", Enum.TextXAlignment.Left)
	captionLabel.Size = UDim2.fromOffset(math.max(200, vp.X - 200), 18)

	-- the engine: beat clock, bars, lines, labels, slow camera push
	local fxConn = RunService.Heartbeat:Connect(function(dt)
		local now = os.clock() - introStart

		-- beat clock: sharp hit on every beat that fades out, every 4th beat is an accent
		local bp = now * BPM / 60
		local idx = math.floor(bp)
		beatEnv = (1 - (bp - idx)) ^ 3
		if idx ~= beatIndex then
			beatIndex = idx
			local accent = (idx % 4 == 0)
			shake = math.max(shake, (accent and 5 or 2) * pulseAmp)
		end

		barCur += (barTarget - barCur) * math.min(1, dt * 5)
		edgeA += (edgeTarget - edgeA) * math.min(1, dt * 3)

		local pulse = beatEnv * pulseAmp
		local th = 2 + 3 * pulse + (lineBoost - 1) * 0.8
		local segTh = th * 1.6 + 1
		local speed = (90 + 650 * pulse) * lineBoost
		local topY, botY = barCur, vp.Y - barCur
		local lineT = 1 - edgeA
		local bandT = 1 - edgeA * (0.5 + 0.5 * pulse)
		local strokeT = 1 - 0.35 * edgeA

		barTop.Size = UDim2.new(1, 0, 0, barCur)
		barBot.Size = UDim2.new(1, 0, 0, barCur)

		topLine.BackgroundTransparency, botLine.BackgroundTransparency = lineT, lineT
		leftLine.BackgroundTransparency, rightLine.BackgroundTransparency = lineT, lineT
		topLine.Position, topLine.Size = UDim2.fromOffset(0, topY - th / 2), UDim2.new(1, 0, 0, th)
		botLine.Position, botLine.Size = UDim2.fromOffset(0, botY - th / 2), UDim2.new(1, 0, 0, th)
		leftLine.Position, leftLine.Size = UDim2.fromOffset(0, 0), UDim2.new(0, th, 1, 0)
		rightLine.Position, rightLine.Size = UDim2.new(1, -th, 0, 0), UDim2.new(0, th, 1, 0)

		for _, g in ipairs({topGlow, botGlow, leftGlow, rightGlow}) do
			g.BackgroundTransparency = bandT
		end
		topGlow.Position, topGlow.Size = UDim2.fromOffset(0, topY - GLOW), UDim2.new(1, 0, 0, GLOW * 2)
		botGlow.Position, botGlow.Size = UDim2.fromOffset(0, botY - GLOW), UDim2.new(1, 0, 0, GLOW * 2)

		for _, s in ipairs(topSegs) do
			s.u = (s.u + speed * s.k * dt) % (vp.X + s.len)
			s.f.Size = UDim2.fromOffset(s.len, segTh)
			s.f.Position = UDim2.fromOffset(s.u - s.len, topY - segTh / 2)
			s.f.BackgroundTransparency, s.stroke.Transparency = lineT, strokeT
		end
		for _, s in ipairs(botSegs) do
			s.u = (s.u - speed * s.k * dt) % (vp.X + s.len)
			s.f.Size = UDim2.fromOffset(s.len, segTh)
			s.f.Position = UDim2.fromOffset(s.u - s.len, botY - segTh / 2)
			s.f.BackgroundTransparency, s.stroke.Transparency = lineT, strokeT
		end
		for _, s in ipairs(leftSegs) do
			s.u = (s.u - speed * s.k * dt) % (vp.Y + s.len)
			s.f.Size = UDim2.fromOffset(segTh, s.len)
			s.f.Position = UDim2.fromOffset(0, s.u - s.len)
			s.f.BackgroundTransparency, s.stroke.Transparency = lineT, strokeT
		end
		for _, s in ipairs(rightSegs) do
			s.u = (s.u + speed * s.k * dt) % (vp.Y + s.len)
			s.f.Size = UDim2.fromOffset(segTh, s.len)
			s.f.Position = UDim2.fromOffset(vp.X - segTh, s.u - s.len)
			s.f.BackgroundTransparency, s.stroke.Transparency = lineT, strokeT
		end

		-- labels sit in the middle of the bars
		local showLabels = barCur > 18
		recLabel.Visible, timeLabel.Visible, captionLabel.Visible = showLabels, showLabels, showLabels
		if showLabels then
			recLabel.Position = UDim2.fromOffset(14, barCur / 2)
			timeLabel.Position = UDim2.fromOffset(vp.X - 14, barCur / 2)
			captionLabel.Position = UDim2.fromOffset(14, vp.Y - barCur / 2)
			recLabel.TextTransparency = (idx % 2 == 0) and 0 or 0.7
			timeLabel.Text = string.format("%02d:%02d:%02d", math.floor(now / 60), math.floor(now % 60), math.floor((now % 1) * 24))
		end

		-- slow camera push over the whole intro and the static breathing with the beat
		camScale.Scale = 1 + 0.06 * math.clamp(now / 9, 0, 1)
		if fxNoisePulse and now > 0.6 then
			noise.TextTransparency = 0.92 - 0.05 * pulse
		end
	end)
	table.insert(introConns, fxConn)

	-- typed captions, like a cutscene's subtitles
	local CAPTIONS = {
		{0.4, "> booting reanimation core"},
		{2.2, "> syncing client root / server root"},
		{4.4, "> NOTUHHHHHH ONLINE"},
		{6.4, "> detonating intro..."},
	}
	task.spawn(function()
		for _, c in ipairs(CAPTIONS) do
			while not captionDone and (os.clock() - introStart) < c[1] * TS do
				task.wait(0.05)
			end
			if captionDone then return end
			for i = 1, #c[2] do
				if captionDone then return end
				captionLabel.Text = c[2]:sub(1, i) .. "_"
				task.wait(0.025)
			end
			captionLabel.Text = c[2]
		end
	end)

	-- a bright line sweeps across the screen at every scene cut
	local function sweep()
		if REDUCE_FLASHING then return end
		local f = fxFrame(WHITE, 6)
		f.Size = UDim2.new(0, 3, 1, 0)
		f.Position = UDim2.fromOffset(-40, 0)
		local s = Instance.new("UIStroke")
		s.Color = WHITE
		s.Thickness = 6
		s.Transparency = 0.6
		s.Parent = f
		TweenService:Create(f, TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Position = UDim2.fromOffset(vp.X + 40, 0),
		}):Play()
		task.delay(0.6, function() f:Destroy() end)
	end
	sweep()

	-- 1) GROW: the logo grows into the screen from a tiny size, fading in from the middle outwards
	waving, scramP = true, 1
	local GROW = (INTRO_STYLE == "Short") and 0.9 or 1.7
	local t0 = os.clock()
	while true do
		RunService.Heartbeat:Wait()
		local k = (os.clock() - t0) / GROW
		if k >= 1 or skipped then break end
		grow.Scale = 0.12 + 0.88 * easeOutBack(k)
		waveAmp = waveBase * math.clamp(k * 1.5 - 0.3, 0, 1)
		scramP = (1 - k) ^ 1.5
		for _, L in ipairs(chunks) do
			L.label.TextTransparency = 1 - math.clamp(k * 1.5 - L.d * 0.5, 0, 1)
		end
		for _, L in ipairs(subChars) do
			local k0 = 0.4 + 0.5 * (L.order / #SUB)
			L.label.TextTransparency = 1 - math.clamp((k - k0) / 0.12, 0, 1)
		end
	end
	grow.Scale, waveAmp, scramP = 1, waveBase, 0
	for _, L in ipairs(flyers) do L.label.TextTransparency = 0 end

	-- 2) HOLD: the wave keeps rolling, the logo breathes a little
	local HOLD = (INTRO_STYLE == "Short") and 0.2 or 1.6
	lineBoost = 1.4
	t0 = os.clock()
	while os.clock() - t0 < HOLD and not skipped do
		RunService.Heartbeat:Wait()
		grow.Scale = 1 + 0.015 * math.sin((os.clock() - t0) * 3) + 0.03 * beatEnv
	end

	-- 3) CHARGE: the wave gets faster and taller, the ascii corrupts, the screen shakes
	local CHARGE = (INTRO_STYLE == "Short") and 0.5 or 0.9
	sweep()
	t0 = os.clock()
	while true do
		RunService.Heartbeat:Wait()
		local k = (os.clock() - t0) / CHARGE
		if k >= 1 or skipped then break end
		grow.Scale = 1 + 0.08 * k + 0.03 * beatEnv
		lineBoost = 1.5 + 2.5 * k
		waveAmp = waveBase * (1 + k)
		waveSpeed = 3 + k * 7
		jit = 1 + k * 7
		scramP = 0.03 + k * 0.4
		shake = 3 + k * 14
	end

	-- 4) BOOM (not when the intro was skipped)
	if not skipped then
	waving = false
	scramP, jit = 0, 0
	grow.Scale = 1
	shake = 30
	lineBoost = 5
	barTarget = 0
	fxNoisePulse = false

	local flash = Instance.new("Frame")
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = WHITE
	flash.BackgroundTransparency = REDUCE_FLASHING and 0.6 or 0.1
	flash.BorderSizePixel = 0
	flash.ZIndex = 7
	flash.Parent = gui
	TweenService:Create(flash, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
	task.delay(0.55, function() flash:Destroy() end)

	-- STATIC: the ascii noise layer jumps to full brightness and flickers every frame
	activePool, noiseRate = densePool, REDUCE_FLASHING and 0.25 or 0
	noise.TextTransparency = REDUCE_FLASHING and 0.5 or 0.1

	for _, L in ipairs(flyers) do
		L.label.Text = L.text
		L.label.Rotation = 0
		L.label.Position = UDim2.fromOffset(L.x, L.y)
		L.vx = (L.x - cx) * 4 + (math.random() - 0.5) * 300
		L.vy = (L.y - cy) * 2 - math.random(200, 700)
		L.vr = (math.random() - 0.5) * 1000
		L.rot = 0
	end

	-- ascii debris
	local SPK = "#:.+*%@01<>/|=-"
	local sparks = {}
	for _ = 1, 90 do
		local ssz = math.random(8, 22)
		local f = Instance.new("TextLabel")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Size = UDim2.fromOffset(ssz, ssz)
		f.BackgroundTransparency = 1
		f.Font = ASCII_FONT
		f.TextSize = ssz
		local k = math.random(#SPK)
		f.Text = SPK:sub(k, k)
		f.TextColor3 = WHITE
		f.ZIndex = 6
		local px = cx + (math.random() - 0.5) * logoW * 0.7
		local py = cy + (math.random() - 0.5) * totalH * 0.5
		f.Position = UDim2.fromOffset(px, py)
		f.Parent = gui
		local a = math.random() * math.pi * 2
		local sp = math.random(250, 900)
		table.insert(sparks, {
			f = f, px = px, py = py,
			vx = math.cos(a) * sp, vy = math.sin(a) * sp - 120,
			rot = math.random(0, 360), vr = (math.random() - 0.5) * 900,
		})
	end

	local GRAVITY, BOOM_TIME = 1500, 1.8
	local start = os.clock()
	local calmed = false
	while true do
		local dt = math.min(RunService.Heartbeat:Wait(), 0.05)
		local el = os.clock() - start
		if el > BOOM_TIME or skipped then break end
		local fade = math.clamp((el - 0.7) / 0.9, 0, 1)
		lineBoost = math.max(1, 5 - el * 3)

		-- flicker the static during the blast, then let it settle back to the dim background
		if el < 0.9 then
			noise.TextTransparency = REDUCE_FLASHING and 0.5 or math.random() * 0.35
		elseif not calmed then
			calmed = true
			activePool, noiseRate = pool, 0.05
			TweenService:Create(noise, TweenInfo.new(0.5), {TextTransparency = 0.9}):Play()
		end

		for _, L in ipairs(flyers) do
			L.vy += GRAVITY * dt
			L.px += L.vx * dt
			L.py += L.vy * dt
			L.rot += L.vr * dt
			L.label.Position = UDim2.fromOffset(L.px, L.py)
			L.label.Rotation = L.rot
			L.label.TextTransparency = fade
		end
		for _, S in ipairs(sparks) do
			S.vy += GRAVITY * 0.6 * dt
			S.px += S.vx * dt
			S.py += S.vy * dt
			S.rot += S.vr * dt
			S.f.Position = UDim2.fromOffset(S.px, S.py)
			S.f.Rotation = S.rot
			S.f.TextTransparency = fade
		end
	end

	end

	shakeConn:Disconnect()
	noiseConn:Disconnect()
	waveConn:Disconnect()
	stage.Position = UDim2.fromScale(0.5, 0.5)
	skipHint.Visible = false
	edgeTarget = 0
	barTarget = 0
	captionDone = true
	for _, L in ipairs(flyers) do
		TweenService:Create(L.label, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
	end
	TweenService:Create(noise, TweenInfo.new(0.35), {TextTransparency = 1}):Play()
	TweenService:Create(base, TweenInfo.new(0.35), {BackgroundTransparency = 1}):Play()
	task.wait(0.4)
	fxConn:Disconnect()
	gui:Destroy()
end

