-- character width and line height of the monospace font at a given size
local function asciiMetrics(size)
	local big = Vector2.new(1000, 1000)
	local cw = TextService:GetTextSize("#", size, ASCII_FONT, big).X
	local lh = TextService:GetTextSize("#\n#", size, ASCII_FONT, big).Y / 2
	if cw <= 0 then cw = size * 0.55 end
	if lh <= 0 then lh = size end
	return cw, lh
end

----------------------------------------------------------------
-- Loading screen (black & white ASCII logo: grows in, waves, explodes into static)
----------------------------------------------------------------
local introGui
local introConns = {}

local function playIntro()
	repeat task.wait() until workspace.CurrentCamera
	local vp = workspace.CurrentCamera.ViewportSize
	local cx, cy = vp.X / 2, vp.Y / 2
	local WHITE = Color3.new(1, 1, 1)

	local gui = Instance.new("ScreenGui")
	gui.Name = tostring(math.random(1000000, 9000000))
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 2147483647
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local hidden = (gethui and gethui()) or (get_hidden_gui and get_hidden_gui())
	if not pcall(function() gui.Parent = hidden or CoreGui end) then
		gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	end
	introGui = gui

	local base = Instance.new("Frame")
	base.Size = UDim2.fromScale(1, 1)
	base.BackgroundColor3 = Color3.new(0, 0, 0)
	base.BorderSizePixel = 0
	base.ZIndex = 1
	base.Parent = gui

	-- dim ascii static in the back (it turns into the big static burst when the logo explodes)
	local NSIZE = 12
	local ncw, nlh = asciiMetrics(NSIZE)
	local ncols, nrows = math.ceil(vp.X / ncw) + 1, math.ceil(vp.Y / nlh) + 1
	local NPOOL = "01#:.+*%@=-"
	local pool, densePool = {}, {}
	for i = 1, 40 do
		local r, d = table.create(ncols), table.create(ncols)
		for c = 1, ncols do
			local k = math.random(#NPOOL)
			r[c] = (math.random() < 0.55) and " " or NPOOL:sub(k, k)
			k = math.random(#NPOOL)
			d[c] = (math.random() < 0.08) and " " or NPOOL:sub(k, k)
		end
		pool[i] = table.concat(r)
		densePool[i] = table.concat(d)
	end
	local activePool, noiseRate = pool, 0.05

	local noise = Instance.new("TextLabel")
	noise.BackgroundTransparency = 1
	noise.Size = UDim2.fromScale(1, 1)
	noise.Font = ASCII_FONT
	noise.TextSize = NSIZE
	noise.TextColor3 = WHITE
	noise.TextTransparency = 1
	noise.TextXAlignment = Enum.TextXAlignment.Left
	noise.TextYAlignment = Enum.TextYAlignment.Top
	noise.TextWrapped = false
	noise.ZIndex = 2
	noise.Parent = gui
	TweenService:Create(noise, TweenInfo.new(0.5), {TextTransparency = 0.9}):Play()
	local function tickNoise()
		local lines = table.create(nrows)
		for i = 1, nrows do lines[i] = activePool[math.random(#activePool)] end
		noise.Text = table.concat(lines, "\n")
	end
	tickNoise()
	local nacc = 0
	local noiseConn = RunService.Heartbeat:Connect(function(dt)
		nacc += dt
		if nacc >= noiseRate then
			nacc = 0
			tickNoise()
		end
	end)

	-- everything that shakes lives in here
	local stage = Instance.new("Frame")
	stage.Size = UDim2.fromScale(1, 1)
	stage.BackgroundTransparency = 1
	stage.BorderSizePixel = 0
	stage.ZIndex = 3
	stage.Parent = gui

	local shake = 0
	local shakeConn = RunService.Heartbeat:Connect(function(dt)
		shake *= math.exp(-9 * dt)
		if shake < 0.3 then
			stage.Position = UDim2.fromOffset(0, 0)
		else
			stage.Position = UDim2.fromOffset((math.random() * 2 - 1) * shake, (math.random() * 2 - 1) * shake)
		end
	end)

	-- tap anywhere to skip the intro
	local skipped = false
	local skipBtn = Instance.new("TextButton")
	skipBtn.Size = UDim2.fromScale(1, 1)
	skipBtn.BackgroundTransparency = 1
	skipBtn.Text = ""
	skipBtn.AutoButtonColor = false
	skipBtn.ZIndex = 50
	skipBtn.Parent = gui
	skipBtn.Activated:Connect(function() skipped = true end)

	local skipHint = Instance.new("TextLabel")
	skipHint.AnchorPoint = Vector2.new(0.5, 1)
	skipHint.Position = UDim2.new(0.5, 0, 1, -12)
	skipHint.Size = UDim2.fromOffset(200, 20)
	skipHint.BackgroundTransparency = 1
	skipHint.Font = ASCII_FONT
	skipHint.TextSize = 14
	skipHint.TextColor3 = WHITE
	skipHint.TextTransparency = 0.6
	skipHint.Text = "[ tap to skip ]"
	skipHint.ZIndex = 51
	skipHint.Parent = gui

	-- the logo root fills the screen; a UIScale on it makes the whole logo "grow into" the screen
	local root = Instance.new("Frame")
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.ZIndex = 3
	root.Parent = stage
	local grow = Instance.new("UIScale")
	grow.Scale = 0.12
	grow.Parent = root

	-- size the logo to the screen (phones too)
	local LOGO = LOGO_BIG
	local LCOLS, LROWS = #LOGO[1], #LOGO
	local TILE_C, TILE_R = 4, 7 -- the logo is cut into tiles of 4 columns x 7 rows
	local SUB = "N O T U H H H H H H   R E A N I M A T I O N S"
	local cw20, lh20 = asciiMetrics(20)
	local cwr, lhr = cw20 / 20, lh20 / 20
	local sizeW = math.floor(vp.X * 0.8 / (LCOLS * cwr))
	local sizeH = math.floor(vp.Y * 0.6 / (LROWS * lhr))
	local size = math.clamp(math.min(sizeW, sizeH), 5, 30)
	local cw, lh = asciiMetrics(size)
	local subSize = math.clamp(math.min(math.floor(vp.X * 0.85 / (#SUB * cwr)), math.floor(size * 1.5)), 7, 30)
	local scw, slh = asciiMetrics(subSize)
	local gap = lh * 2
	local logoH = LROWS * lh
	local logoW = LCOLS * cw
	local subW = #SUB * scw
	local totalH = logoH + gap + slh
	local y0 = cy - totalH / 2
	local bx = cx - logoW / 2
	local waveBase = math.max(5, math.floor(logoH * 0.05))

	local flyers, chunks, subChars = {}, {}, {}
	local function makeFlyer(o)
		local l = Instance.new("TextLabel")
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.Size = UDim2.fromOffset(o.w, o.h)
		l.Position = UDim2.fromOffset(o.x, o.y)
		l.BackgroundTransparency = 1
		l.Font = ASCII_FONT
		l.TextSize = o.size
		l.Text = o.text
		l.TextColor3 = WHITE
		l.TextTransparency = 1
		l.TextXAlignment = o.align
		l.TextYAlignment = Enum.TextYAlignment.Top
		l.TextWrapped = false
		l.ZIndex = 3
		l.Parent = root
		local L = {
			label = l, text = o.text, x = o.x, y = o.y, px = o.x, py = o.y,
			vx = 0, vy = 0, rot = 0, vr = 0,
			scr = o.scr, ampMul = o.ampMul, rotMul = o.rotMul,
			ph = o.ph, d = o.d or 0, order = o.order or 0,
		}
		table.insert(flyers, L)
		return L
	end

	-- logo tiles (empty tiles are skipped)
	local ncg, nrg = math.floor(LCOLS / TILE_C), math.floor(LROWS / TILE_R)
	for gr = 1, nrg do
		for gc = 1, ncg do
			local lines, any = {}, false
			for r = (gr - 1) * TILE_R + 1, gr * TILE_R do
				local seg = LOGO[r]:sub((gc - 1) * TILE_C + 1, gc * TILE_C)
				if seg:find("%S") then any = true end
				lines[#lines + 1] = seg
			end
			if any then
				local x = bx + ((gc - 1) * TILE_C + TILE_C / 2) * cw
				local y = y0 + ((gr - 1) * TILE_R + TILE_R / 2) * lh
				local dx = (x - cx) / (logoW / 2)
				local dy = (y - (y0 + logoH / 2)) / (logoH / 2)
				table.insert(chunks, makeFlyer({
					w = TILE_C * cw + 2, h = TILE_R * lh,
					x = x, y = y, size = size,
					text = table.concat(lines, "\n"), align = Enum.TextXAlignment.Left,
					scr = true, ampMul = 1, rotMul = 0,
					ph = (x - cx) / logoW * math.pi * 2 * 1.2,
					d = math.clamp(math.sqrt(dx * dx + dy * dy) / 1.5, 0, 1),
				}))
			end
		end
	end

	-- name under the logo: one label per letter so the wave runs through it too
	local subX0 = cx - subW / 2
	local subY = y0 + logoH + gap + slh / 2
	for i = 1, #SUB do
		local ch = SUB:sub(i, i)
		if ch ~= " " then
			local x = subX0 + (i - 0.5) * scw
			table.insert(subChars, makeFlyer({
				w = scw + 2, h = slh, x = x, y = subY,
				size = subSize, text = ch, align = Enum.TextXAlignment.Center,
				scr = false, ampMul = 0.6, rotMul = 0.6,
				ph = (x - cx) / subW * math.pi * 2 * 1.5, order = i,
			}))
		end
	end

	-- ascii "decode" effect: random characters that resolve into the real art
	local SCR = "#:.+*%@01<>/\\|=-"
	local function scrambled(text, p)
		return (text:gsub("%S", function()
			if math.random() < p then
				local k = math.random(#SCR)
				return SCR:sub(k, k)
			end
		end))
	end

	-- the sine wave: a traveling wave runs left -> right through the logo and the name
	local waving, waveAmp, waveSpeed, jit, scramP = false, 0, 3, 0, 0
	local wt = 0
	local waveConn = RunService.Heartbeat:Connect(function(dt)
		if not waving then return end
		wt += dt * waveSpeed
		for _, L in ipairs(flyers) do
			local amp = waveAmp * L.ampMul
			local x, y = L.x, L.y + math.sin(wt + L.ph) * amp
			if jit > 0 then
				x += (math.random() * 2 - 1) * jit
				y += (math.random() * 2 - 1) * jit
			end
			L.label.Position = UDim2.fromOffset(x, y)
			L.label.Rotation = math.cos(wt + L.ph) * waveAmp * 0.25 * L.rotMul
			if L.scr then
				if scramP > 0 then
					L.label.Text = scrambled(L.text, scramP)
					L.dirty = true
				elseif L.dirty then
					L.label.Text = L.text
					L.dirty = false
				end
			end
		end
	end)

	local function easeOutBack(k)
		local c1 = 1.70158
		local c3 = c1 + 1
		return 1 + c3 * (k - 1) ^ 3 + c1 * (k - 1) ^ 2
	end

	table.insert(introConns, noiseConn)
	table.insert(introConns, shakeConn)
	table.insert(introConns, waveConn)

	-- 1) GROW: the logo grows into the screen from a tiny size, fading in from the middle outwards
	waving, scramP = true, 1
	local GROW = 1.7
	local t0 = os.clock()
	while true do
		RunService.Heartbeat:Wait()
		local k = (os.clock() - t0) / GROW
		if k >= 1 or skipped then break end
		grow.Scale = 0.12 + 0.88 * easeOutBack(k)
		waveAmp = waveBase * math.clamp(k * 1.5 - 0.3, 0, 1)
		scramP = (1 - k) ^ 1.5
		for _, L in ipairs(chunks) do
			L.label.TextTransparency = 1 - math.clamp(k * 1.5 - L.d * 0.5, 0, 1)
		end
		for _, L in ipairs(subChars) do
			local k0 = 0.4 + 0.5 * (L.order / #SUB)
			L.label.TextTransparency = 1 - math.clamp((k - k0) / 0.12, 0, 1)
		end
	end
	grow.Scale, waveAmp, scramP = 1, waveBase, 0
	for _, L in ipairs(flyers) do L.label.TextTransparency = 0 end

	-- 2) HOLD: the wave keeps rolling, the logo breathes a little
	local HOLD = 1.6
	t0 = os.clock()
	while os.clock() - t0 < HOLD and not skipped do
		RunService.Heartbeat:Wait()
		grow.Scale = 1 + 0.015 * math.sin((os.clock() - t0) * 3)
	end

	-- 3) CHARGE: the wave gets faster and taller, the ascii corrupts, the screen shakes
	local CHARGE = 0.9
	t0 = os.clock()
	while true do
		RunService.Heartbeat:Wait()
		local k = (os.clock() - t0) / CHARGE
		if k >= 1 or skipped then break end
		grow.Scale = 1 + 0.08 * k
		waveAmp = waveBase * (1 + k)
		waveSpeed = 3 + k * 7
		jit = 1 + k * 7
		scramP = 0.03 + k * 0.4
		shake = 3 + k * 14
	end

	-- 4) BOOM (not when the intro was skipped)
	if not skipped then
	waving = false
	scramP, jit = 0, 0
	grow.Scale = 1
	shake = 30

	local flash = Instance.new("Frame")
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = WHITE
	flash.BackgroundTransparency = REDUCE_FLASHING and 0.6 or 0.1
	flash.BorderSizePixel = 0
	flash.ZIndex = 7
	flash.Parent = gui
	TweenService:Create(flash, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
	task.delay(0.55, function() flash:Destroy() end)

	-- STATIC: the ascii noise layer jumps to full brightness and flickers every frame
	activePool, noiseRate = densePool, REDUCE_FLASHING and 0.25 or 0
	noise.TextTransparency = REDUCE_FLASHING and 0.5 or 0.1

	for _, L in ipairs(flyers) do
		L.label.Text = L.text
		L.label.Rotation = 0
		L.label.Position = UDim2.fromOffset(L.x, L.y)
		L.vx = (L.x - cx) * 4 + (math.random() - 0.5) * 300
		L.vy = (L.y - cy) * 2 - math.random(200, 700)
		L.vr = (math.random() - 0.5) * 1000
		L.rot = 0
	end

	-- ascii debris
	local SPK = "#:.+*%@01<>/|=-"
	local sparks = {}
	for _ = 1, 90 do
		local ssz = math.random(8, 22)
		local f = Instance.new("TextLabel")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Size = UDim2.fromOffset(ssz, ssz)
		f.BackgroundTransparency = 1
		f.Font = ASCII_FONT
		f.TextSize = ssz
		local k = math.random(#SPK)
		f.Text = SPK:sub(k, k)
		f.TextColor3 = WHITE
		f.ZIndex = 6
		local px = cx + (math.random() - 0.5) * logoW * 0.7
		local py = cy + (math.random() - 0.5) * totalH * 0.5
		f.Position = UDim2.fromOffset(px, py)
		f.Parent = gui
		local a = math.random() * math.pi * 2
		local sp = math.random(250, 900)
		table.insert(sparks, {
			f = f, px = px, py = py,
			vx = math.cos(a) * sp, vy = math.sin(a) * sp - 120,
			rot = math.random(0, 360), vr = (math.random() - 0.5) * 900,
		})
	end

	local GRAVITY, BOOM_TIME = 1500, 1.8
	local start = os.clock()
	local calmed = false
	while true do
		local dt = math.min(RunService.Heartbeat:Wait(), 0.05)
		local el = os.clock() - start
		if el > BOOM_TIME or skipped then break end
		local fade = math.clamp((el - 0.7) / 0.9, 0, 1)

		-- flicker the static during the blast, then let it settle back to the dim background
		if el < 0.9 then
			noise.TextTransparency = REDUCE_FLASHING and 0.5 or math.random() * 0.35
		elseif not calmed then
			calmed = true
			activePool, noiseRate = pool, 0.05
			TweenService:Create(noise, TweenInfo.new(0.5), {TextTransparency = 0.9}):Play()
		end

		for _, L in ipairs(flyers) do
			L.vy += GRAVITY * dt
			L.px += L.vx * dt
			L.py += L.vy * dt
			L.rot += L.vr * dt
			L.label.Position = UDim2.fromOffset(L.px, L.py)
			L.label.Rotation = L.rot
			L.label.TextTransparency = fade
		end
		for _, S in ipairs(sparks) do
			S.vy += GRAVITY * 0.6 * dt
			S.px += S.vx * dt
			S.py += S.vy * dt
			S.rot += S.vr * dt
			S.f.Position = UDim2.fromOffset(S.px, S.py)
			S.f.Rotation = S.rot
			S.f.TextTransparency = fade
		end
	end

	end

	shakeConn:Disconnect()
	noiseConn:Disconnect()
	waveConn:Disconnect()
	stage.Position = UDim2.fromOffset(0, 0)
	skipHint.Visible = false
	for _, L in ipairs(flyers) do
		TweenService:Create(L.label, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
	end
	TweenService:Create(noise, TweenInfo.new(0.35), {TextTransparency = 1}):Play()
	TweenService:Create(base, TweenInfo.new(0.35), {BackgroundTransparency = 1}):Play()
	task.wait(0.4)
	gui:Destroy()
end

----------------------------------------------------------------
-- Backgrounds: ASCII plasma (default), none, a .txt ascii art file, or an image
--   <data folder>/Content/backgrounds/   (also accepted: "background", "background grounds")
----------------------------------------------------------------
local BG_PLASMA, BG_NONE = "ASCII Plasma (default)", "None"
local BG_FOLDER_KEYS = {backgrounds = true, background = true, backgroundgrounds = true}
local BG_IMAGE_EXT = {png = true, jpg = true, jpeg = true, webp = true, bmp = true}
local getAsset = getcustomasset or getsynasset
local BG_SAVE_FILE = DATA_FOLDER .. "/NOTbackground.txt"

local BG = {current = BG_PLASMA, byName = {}, names = {BG_PLASMA, BG_NONE}, apply = nil}

-- remember the last choice
do
	local ok, saved = pcall(function()
		if isfile(BG_SAVE_FILE) then return readfile(BG_SAVE_FILE) end
		return nil
	end)
	if ok and type(saved) == "string" then
		saved = saved:gsub("[\r\n]+", "")
		if #saved > 0 then BG.current = saved end
	end
end

local function bgNorm(s)
	return (s:lower():gsub("[%s_%-]", ""))
end

-- lists the backgrounds. With create = true the folder is made when it doesn't exist yet.
function BG.scan(create)
	local base = DATA_FOLDER .. "/Content"
	local names, byName = {BG_PLASMA, BG_NONE}, {}
	local foundFolder = false
	local okL, list = pcall(listfiles, base)
	if okL and type(list) == "table" then
		for _, p in ipairs(list) do
			local n = p:match("([^/\\]+)$")
			local okD, isD = pcall(isfolder, p)
			if n and okD and isD and BG_FOLDER_KEYS[bgNorm(n)] then
				foundFolder = true
				local okF, files = pcall(listfiles, p)
				if okF and type(files) == "table" then
					table.sort(files)
					for _, f in ipairs(files) do
						local fname = f:match("([^/\\]+)$")
						local ext = fname and fname:match("%.([^%.]+)$")
						ext = ext and ext:lower()
						local kind = nil
						if ext == "txt" then
							kind = "text"
						elseif ext and BG_IMAGE_EXT[ext] then
							kind = "image"
						end
						local okFile, isFile = pcall(isfile, f)
						if kind and okFile and isFile and not byName[fname] then
							byName[fname] = {kind = kind, path = f}
							table.insert(names, fname)
						end
					end
				end
			end
		end
	end
	if create and not foundFolder then
		pcall(makefolder, DATA_FOLDER)
		pcall(makefolder, base)
		pcall(makefolder, base .. "/backgrounds")
	end
	BG.names, BG.byName = names, byName
	return names
end

function BG.set(name)
	BG.current = name
	pcall(writefile, BG_SAVE_FILE, name)
	if BG.apply then BG.apply() end
end

