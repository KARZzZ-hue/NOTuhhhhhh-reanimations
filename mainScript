	local function clearTrails()
		for _, o in ipairs(trailState.objs) do
			pcall(function()
				o.trail:Destroy()
				o.a0:Destroy()
				o.a1:Destroy()
			end)
		end
		trailState.objs = {}
		trailState.parts = {}
	end
	local function buildTrails(parts)
		clearTrails()
		local half = T.Width / 2
		for _, part in ipairs(parts) do
			local a0 = Instance.new("Attachment")
			local a1 = Instance.new("Attachment")
			a0.Name, a1.Name = "NOTTrailA0", "NOTTrailA1"
			if T.Orientation == "Horizontal" then
				a0.Position, a1.Position = Vector3.new(half, 0, 0), Vector3.new(-half, 0, 0)
			else
				a0.Position, a1.Position = Vector3.new(0, half, 0), Vector3.new(0, -half, 0)
			end
			a0.Parent, a1.Parent = part, part
			local tr = Instance.new("Trail")
			tr.Name = "NOTTrail"
			tr.Attachment0, tr.Attachment1 = a0, a1
			tr.Lifetime = T.Lifetime
			tr.LightEmission = T.LightEmission
			tr.FaceCamera = T.FaceCamera
			tr.MinLength = 0.05
			tr.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, T.Transparency),
				NumberSequenceKeypoint.new(1, 1),
			})
			tr.Color = ColorSequence.new(Color3.fromRGB(T.R, T.G, T.B))
			tr.Parent = part
			table.insert(trailState.objs, {trail = tr, a0 = a0, a1 = a1})
		end
		trailState.parts = parts
		trailState.dirty = false
	end

	-- aura particles
	local function clearAura()
		for _, e in ipairs(auraState.objs) do
			pcall(function() e:Destroy() end)
		end
		auraState.objs = {}
		auraState.parts = {}
	end
	local function buildAura(parts)
		clearAura()
		for _, part in ipairs(parts) do
			local e = Instance.new("ParticleEmitter")
			e.Name = "NOTAura"
			e.Texture = AURA_TEXTURES[A.Style] or AURA_TEXTURES.Sparkles
			e.Rate = A.Rate
			e.Lifetime = NumberRange.new(A.Lifetime * 0.7, A.Lifetime * 1.3)
			e.Speed = NumberRange.new(A.Speed * 0.5, A.Speed)
			e.Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, A.Size),
				NumberSequenceKeypoint.new(1, 0),
			})
			e.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.7, 0.3),
				NumberSequenceKeypoint.new(1, 1),
			})
			e.LightEmission = A.LightEmission
			e.Color = ColorSequence.new(Color3.fromRGB(A.R, A.G, A.B))
			e.SpreadAngle = Vector2.new(180, 180)
			e.Rotation = NumberRange.new(0, 360)
			e.RotSpeed = NumberRange.new(-60, 60)
			e.Parent = part
			table.insert(auraState.objs, e)
		end
		auraState.parts = parts
		auraState.dirty = false
	end

	-- glow
	local function clearGlow()
		if glowState.obj then
			pcall(function() glowState.obj:Destroy() end)
		end
		glowState.obj, glowState.part = nil, nil
	end

	-- outline
	local function clearOutline()
		if outlineState.obj then
			pcall(function() outlineState.obj:Destroy() end)
		end
		outlineState.obj, outlineState.model = nil, nil
	end

	-- root outlines (blocky selection boxes)
	local rootBoxes = {}
	local function clearRootBoxes()
		for k, b in pairs(rootBoxes) do
			pcall(function() b:Destroy() end)
			rootBoxes[k] = nil
		end
	end
	local function ensureRootBox(key, part)
		local box = rootBoxes[key]
		if not part then
			if box then
				pcall(function() box:Destroy() end)
				rootBoxes[key] = nil
			end
			return
		end
		if box and box.Parent and box.Adornee == part then return end
		if box then pcall(function() box:Destroy() end) end
		local b = Instance.new("SelectionBox")
		b.Name = "NOTRoot" .. key
		b.Adornee = part
		b.Transparency = 0
		b.Parent = workspace.CurrentCamera or workspace
		rootBoxes[key] = b
	end

	-- dancing ghosts
	local ghosts = {}
	local function clearGhosts()
		for _, g in ipairs(ghosts) do
			pcall(function() g:Destroy() end)
		end
		ghosts = {}
	end

	local function isDancing()
		if D.Trigger == "Always" then return true end
		if UISound then
			if type(UISound) == "table" then
				local dm = UISound.DanceMusic
				if typeof(dm) == "Instance" and dm:IsA("Sound") and dm.IsPlaying then return true end
				for k, v in pairs(UISound) do
					if typeof(v) == "Instance" and v:IsA("Sound") and v.IsPlaying
						and tostring(k):lower():find("dance") then
						return true
					end
				end
			end
		end
		for _, m in ipairs(bodyModels()) do
			local hum = m:FindFirstChildOfClass("Humanoid")
			local animator = hum and hum:FindFirstChildOfClass("Animator")
			if animator then
				for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
					local pr = track.Priority.Name
					if pr == "Action" or pr == "Action2" or pr == "Action3" or pr == "Action4" then
						return true
					end
				end
			end
		end
		return false
	end

	-- a plain solid copy of one body part (keeps meshes, drops textures, faces, welds, scripts...)
	local function ghostOf(part)
		local okC, c = pcall(function() return part:Clone() end)
		if not okC or not c then
			c = Instance.new("Part")
			c.Size = part.Size
		end
		for _, ch in ipairs(c:GetChildren()) do
			if ch:IsA("DataModelMesh") then
				pcall(function() ch.TextureId = "" end)
			else
				ch:Destroy()
			end
		end
		if c:IsA("MeshPart") then
			pcall(function() c.TextureID = "" end)
		end
		c.Anchored = true
		c.CanCollide = false
		c.CanQuery = false
		c.CanTouch = false
		c.Massless = true
		c.CastShadow = false
		c.CFrame = part.CFrame
		return c
	end

	local function spawnGhost()
		local parts = visibleBodyParts()
		if #parts == 0 then return end
		local folder = Instance.new("Folder")
		folder.Name = "NOTGhost"
		local color = D.Rainbow and rainbowColor(os.clock() * 1.3) or Color3.fromRGB(D.R, D.G, D.B)
		local material = Enum.Material.Neon
		pcall(function() material = Enum.Material[D.Material] end)
		local fade = math.max(0.1, D.Fade)
		for i, part in ipairs(parts) do
			if i > 80 then break end
			local c = ghostOf(part)
			c.Color = color
			c.Material = material
			c.Transparency = D.StartTransparency
			c.Parent = folder
			local goal = {Transparency = 1}
			if D.Expand > 0 then goal.Size = c.Size * (1 + D.Expand) end
			TweenService:Create(c, TweenInfo.new(fade, Enum.EasingStyle.Linear), goal):Play()
		end
		folder.Parent = workspace.CurrentCamera or workspace
		table.insert(ghosts, folder)
		task.delay(fade + 0.2, function() folder:Destroy() end)
		for i = #ghosts, 1, -1 do
			if not ghosts[i].Parent then table.remove(ghosts, i) end
		end
		while #ghosts > D.MaxGhosts do
			local old = table.remove(ghosts, 1)
			pcall(function() old:Destroy() end)
		end
	end

	-- info overlay (FPS / ping / time)
	local hud = {gui = nil, label = nil, acc = 0, frames = 0, corner = nil}
	local function clearHud()
		if hud.gui then
			pcall(function() hud.gui:Destroy() end)
		end
		hud.gui, hud.label, hud.corner = nil, nil, nil
	end
	local function makeHud()
		local g = Instance.new("ScreenGui")
		g.Name = tostring(math.random(1000000, 9000000))
		g.ResetOnSpawn = false
		g.IgnoreGuiInset = true
		g.DisplayOrder = 2147483000
		local hidden = (gethui and gethui()) or (get_hidden_gui and get_hidden_gui())
		if not pcall(function() g.Parent = hidden or CoreGui end) then
			g.Parent = LocalPlayer:FindFirstChild("PlayerGui")
		end
		local l = Instance.new("TextLabel")
		l.AutomaticSize = Enum.AutomaticSize.XY
		l.Size = UDim2.fromOffset(0, 0)
		l.BackgroundColor3 = Color3.new(0, 0, 0)
		l.BackgroundTransparency = 0.45
		l.BorderSizePixel = 0
		l.TextColor3 = Color3.new(1, 1, 1)
		l.Font = ASCII_FONT
		l.TextSize = 13
		l.Text = "FPS --"
		l.Parent = g
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 6), UDim.new(0, 6)
		pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 3), UDim.new(0, 3)
		pad.Parent = l
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 4)
		corner.Parent = l
		hud.gui, hud.label, hud.corner = g, l, nil
	end

	----------------------------------------------------------------
	-- run everything
	----------------------------------------------------------------
	local trailAcc, auraAcc, glowAcc, outlineAcc, ghostAcc = 0, 0, 0, 0, 0

	local function stepTrail(dt)
		if T.Enabled then
			trailAcc += dt
			if trailAcc >= 0.25 or trailState.dirty then
				trailAcc = 0
				local parts = resolveTrailParts(T.Location)
				if trailState.dirty or not sameParts(parts, trailState.parts) then
					buildTrails(parts)
				end
			end
			if T.Rainbow then
				local seq = rainbowSequence(os.clock())
				for _, o in ipairs(trailState.objs) do o.trail.Color = seq end
			end
		elseif #trailState.objs > 0 then
			clearTrails()
		end
	end

	local function stepAura(dt)
		if A.Enabled then
			auraAcc += dt
			if auraAcc >= 0.25 or auraState.dirty then
				auraAcc = 0
				local parts = resolveTrailParts(A.Location)
				if auraState.dirty or not sameParts(parts, auraState.parts) then
					buildAura(parts)
				end
			end
			if A.Rainbow then
				local seq = rainbowSequence(os.clock())
				for _, e in ipairs(auraState.objs) do e.Color = seq end
			end
		elseif #auraState.objs > 0 then
			clearAura()
		end
	end

	local function stepGlow(dt)
		if G.Enabled then
			glowAcc += dt
			if glowAcc >= 0.25 or glowState.dirty then
				glowAcc = 0
				local wasDirty = glowState.dirty
				glowState.dirty = false
				local part = resolveTrailParts(G.Location)[1]
				if part and (wasDirty or glowState.part ~= part or not glowState.obj or not glowState.obj.Parent) then
					clearGlow()
					local l = Instance.new("PointLight")
					l.Name = "NOTGlow"
					l.Brightness = G.Brightness
					l.Range = G.Range
					l.Color = Color3.fromRGB(G.R, G.G, G.B)
					l.Parent = part
					glowState.obj, glowState.part = l, part
				end
			end
			if G.Rainbow and glowState.obj then
				glowState.obj.Color = rainbowColor(os.clock())
			end
		elseif glowState.obj then
			clearGlow()
		end
	end

	local function stepOutline(dt)
		if O.Enabled then
			outlineAcc += dt
			if outlineAcc >= 0.25 or outlineState.dirty then
				outlineAcc = 0
				local wasDirty = outlineState.dirty
				outlineState.dirty = false
				local model = visibleBodyModel()
				if model and (wasDirty or outlineState.model ~= model or not outlineState.obj or not outlineState.obj.Parent) then
					clearOutline()
					local h = Instance.new("Highlight")
					h.Name = "NOTOutline"
					h.Adornee = model
					h.FillTransparency = O.FillTransparency
					h.OutlineTransparency = O.OutlineTransparency
					h.DepthMode = O.AlwaysOnTop and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
					local c = Color3.fromRGB(O.R, O.G, O.B)
					h.FillColor, h.OutlineColor = c, c
					h.Parent = workspace.CurrentCamera or workspace
					outlineState.obj, outlineState.model = h, model
				end
			end
			if O.Rainbow and outlineState.obj then
				local c = rainbowColor(os.clock())
				outlineState.obj.FillColor, outlineState.obj.OutlineColor = c, c
			end
		elseif outlineState.obj then
			clearOutline()
		end
	end

	local rootAcc = 0
	local function stepRoots(dt)
		if not (RT.ClientEnabled or RT.ServerEnabled) then
			if next(rootBoxes) ~= nil then clearRootBoxes() end
			return
		end
		rootAcc += dt
		if rootAcc >= 0.25 or rootState.dirty then
			rootAcc = 0
			rootState.dirty = false
			local client, server = findRootParts()
			ensureRootBox("client", RT.ClientEnabled and client or nil)
			ensureRootBox("server", RT.ServerEnabled and server or nil)
		end
		-- client root: rainbow. server root: inverted rainbow (other direction, opposite hue)
		local t = os.clock() * RT.Speed
		local c1 = Color3.fromHSV(t % 1, 1, 1)
		local c2 = Color3.fromHSV((0.5 - t) % 1, 1, 1)
		local cb, sb = rootBoxes.client, rootBoxes.server
		if cb then
			cb.Color3, cb.SurfaceColor3 = c1, c1
			cb.LineThickness = RT.Thickness
			cb.SurfaceTransparency = RT.FillTransparency
		end
		if sb then
			sb.Color3, sb.SurfaceColor3 = c2, c2
			sb.LineThickness = RT.Thickness
			sb.SurfaceTransparency = RT.FillTransparency
		end
	end

	local function stepGhosts(dt)
		if D.Enabled then
			ghostAcc += dt
			if ghostAcc >= D.Interval then
				ghostAcc = 0
				if isDancing() then spawnGhost() end
			end
		elseif #ghosts > 0 then
			clearGhosts()
		end
	end

	local function stepHud(dt)
		if not U.HudEnabled then
			if hud.gui then clearHud() end
			return
		end
		if not hud.gui then makeHud() end
		if not hud.label then return end
		if hud.corner ~= U.HudCorner then
			hud.corner = U.HudCorner
			local c = U.HudCorner
			local ax = (c == "Top Right" or c == "Bottom Right") and 1 or 0
			local ay = (c == "Bottom Left" or c == "Bottom Right") and 1 or 0
			local y = 8
			if ay == 1 then
				y = -8
			elseif ax == 0 then
				y = 56
			end
			hud.label.AnchorPoint = Vector2.new(ax, ay)
			hud.label.Position = UDim2.new(ax, (ax == 1) and -8 or 8, ay, y)
		end
		hud.frames += 1
		hud.acc += dt
		if hud.acc >= 0.5 then
			local fps = math.floor(hud.frames / hud.acc + 0.5)
			hud.frames, hud.acc = 0, 0
			local ping = "?"
			pcall(function()
				ping = tostring(math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5))
			end)
			hud.label.Text = string.format("FPS %d | PING %sms | %s", fps, ping, os.date("%H:%M"))
		end
	end

	local warned = {}
	local function guarded(name, fn, dt)
		local ok, err = pcall(fn, dt)
		if not ok and not warned[name] then
			warned[name] = true
			warn("[" .. TITLE .. "] " .. name .. " error: " .. tostring(err))
		end
	end
	RunService.Heartbeat:Connect(function(dt)
		guarded("trail", stepTrail, dt)
		guarded("aura", stepAura, dt)
		guarded("glow", stepGlow, dt)
		guarded("outline", stepOutline, dt)
		guarded("roots", stepRoots, dt)
		guarded("ghosts", stepGhosts, dt)
		guarded("overlay", stepHud, dt)
	end)

	-- move the "Config" button right under the Store button (found by its text)
	task.spawn(function()
		local deadline = os.clock() + 180
		while os.clock() < deadline and MainPage.Parent do
			for _, d in ipairs(MainPage:GetDescendants()) do
				if d:IsA("TextLabel") and d ~= cfgBtn then
					local plain = d.Text:gsub("<[^>]*>", ""):lower()
					if plain:find("%f[%a]store%f[%A]") then
						local c = d
						while c and c.Parent ~= MainPage do c = c.Parent end
						if c and c ~= cfgContainer then
							cfgContainer.LayoutOrder = c.LayoutOrder + 1
							return
						end
					end
				end
			end
			task.wait(1)
		end
	end)
end

-- The patched Uhhhhhh source calls this after its "UI Theme" dropdown.
_G.NOTCreateConfigUI = function(UI, MainPage, SaveData, UISound)
	local ok, err = pcall(buildConfigUI, UI, MainPage, SaveData, UISound)
	if not ok then
		warn("[" .. TITLE .. "] config page error: " .. tostring(err))
	end
end

