-- Animated ASCII scenes (they draw into a grid of characters)
----------------------------------------------------------------
local SCENES = {}

local function newGrid(cols, rows, fill)
	local g = table.create(rows)
	for y = 1, rows do
		local row = table.create(cols)
		for x = 1, cols do row[x] = fill end
		g[y] = row
	end
	return g
end

local function gridToString(g, rows)
	local lines = table.create(rows)
	for y = 1, rows do lines[y] = table.concat(g[y]) end
	return table.concat(lines, "\n")
end

-- falling green-rain style columns
SCENES["Matrix Rain"] = {
	new = function(cols, rows)
		local st = {cols = cols, rows = rows, heads = {}, speeds = {}, lens = {}}
		for x = 1, cols do
			st.heads[x] = math.random() * rows * 1.5 - rows * 0.5
			st.speeds[x] = 4 + math.random() * 10
			st.lens[x] = math.random(5, math.max(6, math.floor(rows * 0.8)))
		end
		return st
	end,
	render = function(st, t, dt)
		local cols, rows = st.cols, st.rows
		local glyphs = "01ABCDEFGHIJKLMNOPQRSTUVWXYZ$#@%&*+=<>"
		local ramp = "@#*+=-:."
		local g = newGrid(cols, rows, " ")
		for x = 1, cols do
			local head = st.heads[x] + st.speeds[x] * dt
			if head - st.lens[x] > rows then
				head = -math.random(0, rows)
				st.speeds[x] = 4 + math.random() * 10
				st.lens[x] = math.random(5, math.max(6, math.floor(rows * 0.8)))
			end
			st.heads[x] = head
			local len = st.lens[x]
			for d = 0, len do
				local y = math.floor(head) - d
				if y >= 1 and y <= rows then
					if d == 0 then
						local k = math.random(#glyphs)
						g[y][x] = glyphs:sub(k, k)
					else
						local ri = math.min(#ramp, 1 + math.floor(d / len * #ramp))
						g[y][x] = ramp:sub(ri, ri)
					end
				end
			end
		end
		return gridToString(g, rows)
	end,
}

-- flying through stars
SCENES["Starfield"] = {
	new = function(cols, rows)
		local st = {cols = cols, rows = rows, stars = {}}
		for i = 1, math.max(30, math.floor(cols * rows / 40)) do
			st.stars[i] = {x = math.random() * 2 - 1, y = math.random() * 2 - 1, z = math.random()}
		end
		return st
	end,
	render = function(st, t, dt)
		local cols, rows = st.cols, st.rows
		local g = newGrid(cols, rows, " ")
		for _, s in ipairs(st.stars) do
			s.z -= dt * 0.35
			if s.z <= 0.02 then
				s.x, s.y, s.z = math.random() * 2 - 1, math.random() * 2 - 1, 1
			end
			local px = math.floor(cols / 2 + (s.x / s.z) * cols * 0.25)
			local py = math.floor(rows / 2 + (s.y / s.z) * rows * 0.25)
			if px >= 1 and px <= cols and py >= 1 and py <= rows then
				local ch = "."
				if s.z < 0.12 then
					ch = "@"
				elseif s.z < 0.33 then
					ch = "*"
				elseif s.z < 0.66 then
					ch = "+"
				end
				g[py][px] = ch
			end
		end
		return gridToString(g, rows)
	end,
}

-- two layers of rolling waves
SCENES["Waves"] = {
	new = function(cols, rows) return {cols = cols, rows = rows} end,
	render = function(st, t)
		local cols, rows = st.cols, st.rows
		local g = newGrid(cols, rows, " ")
		for x = 1, cols do
			local h1 = rows * 0.5 + math.sin(x * 0.18 + t * 1.4) * rows * 0.12 + math.sin(x * 0.07 - t * 0.9) * rows * 0.08
			local h2 = rows * 0.72 + math.sin(x * 0.22 - t * 1.1) * rows * 0.07
			local s1, s2 = math.floor(h1 + 0.5), math.floor(h2 + 0.5)
			for y = 1, rows do
				local ch = " "
				if y == s1 then
					ch = "~"
				elseif y > s1 and y < s2 then
					ch = ((x + y) % 4 == 0) and "." or " "
				elseif y == s2 then
					ch = "="
				elseif y > s2 then
					ch = ((x + y) % 2 == 0) and ":" or "."
				end
				g[y][x] = ch
			end
		end
		return gridToString(g, rows)
	end,
}

-- classic ascii fire
SCENES["Fire"] = {
	new = function(cols, rows)
		local heat = table.create(rows + 2)
		for y = 1, rows + 2 do
			heat[y] = table.create(cols)
			for x = 1, cols do heat[y][x] = 0 end
		end
		return {cols = cols, rows = rows, heat = heat}
	end,
	render = function(st, t, dt)
		local cols, rows, heat = st.cols, st.rows, st.heat
		for x = 1, cols do
			heat[rows + 1][x] = (math.random() < 0.65) and math.random(160, 255) or 0
			heat[rows + 2][x] = 0
		end
		for y = 1, rows do
			for x = 1, cols do
				local l = heat[y + 1][math.max(1, x - 1)]
				local r = heat[y + 1][math.min(cols, x + 1)]
				local b1 = heat[y + 1][x]
				local b2 = heat[y + 2][x]
				local v = (l + r + b1 + b2) / 4 * 0.93 - 0.5
				heat[y][x] = (v > 0) and v or 0
			end
		end
		local ramp = " .:^*sS#$@"
		local g = newGrid(cols, rows, " ")
		for y = 1, rows do
			for x = 1, cols do
				local idx = math.clamp(math.floor(heat[y][x] / 256 * #ramp) + 1, 1, #ramp)
				g[y][x] = ramp:sub(idx, idx)
			end
		end
		return gridToString(g, rows)
	end,
}

-- bars that jump with the music (idles with a gentle wave when nothing plays)
SCENES["Music Visualizer"] = {
	new = function(cols, rows)
		local bars = math.max(8, math.floor(cols / 3))
		local st = {cols = cols, rows = rows, bars = bars, level = {}, phase = {}}
		for i = 1, bars do
			st.level[i] = 0
			st.phase[i] = math.random() * 6.28
		end
		return st
	end,
	render = function(st, t, dt, loud)
		local cols, rows, bars = st.cols, st.rows, st.bars
		local amp = math.clamp((loud or 0) / 400, 0, 1)
		local idle = 0.12
		local g = newGrid(cols, rows, " ")
		for i = 1, bars do
			local wave = math.abs(math.sin(t * 3 + st.phase[i] + i * 0.5))
			local target = math.max(idle * (0.4 + 0.6 * wave), amp * (0.3 + 0.7 * wave))
			st.level[i] += (target - st.level[i]) * math.min(1, dt * 10)
			local height = math.floor(st.level[i] * rows)
			local x0 = (i - 1) * 3 + 1
			for y = rows, rows - height + 1, -1 do
				if y >= 1 then
					local ch = (y == rows - height + 1) and "=" or "#"
					for dx = 0, 1 do
						if x0 + dx <= cols then g[y][x0 + dx] = ch end
					end
				end
			end
		end
		return gridToString(g, rows)
	end,
}

-- loudness of whatever music the script is playing right now
local function musicLoudness()
	local us = BG.uiSound
	if not us then return 0 end
	local best = 0
	local function consider(k, v)
		if typeof(v) == "Instance" and v:IsA("Sound") and v.IsPlaying then
			if not tostring(k):lower():find("click") then
				best = math.max(best, v.PlaybackLoudness)
			end
		end
	end
	if type(us) == "table" then
		for k, v in pairs(us) do consider(k, v) end
	elseif typeof(us) == "Instance" then
		for _, v in ipairs(us:GetDescendants()) do consider(v.Name, v) end
	end
	return best
end

