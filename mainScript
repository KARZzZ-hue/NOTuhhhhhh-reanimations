-- Backgrounds: starburst pattern (default), animated ASCII scenes, ASCII plasma, none,
-- a .txt ascii art file, or an image
--   <data folder>/Content/backgrounds/   (also accepted: "background", "background grounds")
----------------------------------------------------------------
local BG_PATTERN, BG_PLASMA, BG_NONE = "Monochrome Pattern", "ASCII Plasma", "None"
local BG_SCENE_NAMES = {"Matrix Rain", "Starfield", "Waves", "Fire", "Music Visualizer"}
local BG_FOLDER_KEYS = {backgrounds = true, background = true, backgroundgrounds = true}
local BG_IMAGE_EXT = {png = true, jpg = true, jpeg = true, webp = true, bmp = true}
local getAsset = getcustomasset or getsynasset
local BG_SAVE_FILE = DATA_FOLDER .. "/NOTbackground.txt"

-- how the backgrounds look (saved with the other settings once the Config page exists)
local BG_CFG_DEFAULTS = {
	PatternAlpha = 0.84, PatternSpeed = 10, PatternTile = 80,
	SceneAlpha = 0.8, SceneFPS = 12,
}

local function copyTable(t)
	local c = {}
	for k, v in pairs(t) do c[k] = v end
	return c
end

local function baseBackgroundNames()
	local names = {BG_PATTERN, BG_PLASMA}
	for _, n in ipairs(BG_SCENE_NAMES) do table.insert(names, n) end
	table.insert(names, BG_NONE)
	return names
end

local BG = {
	current = BG_PATTERN, byName = {}, names = baseBackgroundNames(),
	apply = nil, uiSound = nil, cfg = copyTable(BG_CFG_DEFAULTS),
}

-- The starburst pattern (your image) as a small 128x128 tile, embedded as base64.
-- It is written to the data folder once and loaded with getcustomasset.
local PATTERN_FILE = DATA_FOLDER .. "/NOTpattern_v1.png"
local PATTERN_B64 = ""

local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64_LOOKUP = {}
for i = 1, #B64_CHARS do B64_LOOKUP[B64_CHARS:byte(i)] = i - 1 end

local function base64Decode(data)
	local out, buf, bits = {}, 0, 0
	for i = 1, #data do
		local v = B64_LOOKUP[data:byte(i)]
		if v then
			buf = buf * 64 + v
			bits += 6
			if bits >= 8 then
				bits -= 8
				local byte = math.floor(buf / 2 ^ bits)
				buf = buf % 2 ^ bits
				out[#out + 1] = string.char(byte)
			end
		end
	end
	return table.concat(out)
end

local function patternAsset()
	local ok, asset = pcall(function()
		pcall(makefolder, DATA_FOLDER)
		if not isfile(PATTERN_FILE) then
			writefile(PATTERN_FILE, base64Decode(PATTERN_B64))
		end
		return getcustomasset and getcustomasset(PATTERN_FILE) or getsynasset(PATTERN_FILE)
	end)
	if ok and asset and asset ~= "" then return asset end
	return nil
end

-- remember the last choice
do
	local ok, saved = pcall(function()
		if isfile(BG_SAVE_FILE) then return readfile(BG_SAVE_FILE) end
		return nil
	end)
	if ok and type(saved) == "string" then
		saved = saved:gsub("[\r\n]+", "")
		if saved == "ASCII Plasma (default)" then saved = BG_PLASMA end
		if #saved > 0 then BG.current = saved end
	end
end

local function bgNorm(s)
	return (s:lower():gsub("[%s_%-]", ""))
end

-- lists the backgrounds. With create = true the folder is made when it doesn't exist yet.
function BG.scan(create)
	local base = DATA_FOLDER .. "/Content"
	local names, byName = baseBackgroundNames(), {}
	local foundFolder = false
	local okL, list = pcall(listfiles, base)
	if okL and type(list) == "table" then
		for _, p in ipairs(list) do
			local n = p:match("([^/\\]+)$")
			local okD, isD = pcall(isfolder, p)
			if n and okD and isD and BG_FOLDER_KEYS[bgNorm(n)] then
				foundFolder = true
				local okF, files = pcall(listfiles, p)
				if okF and type(files) == "table" then
					table.sort(files)
					for _, f in ipairs(files) do
						local fname = f:match("([^/\\]+)$")
						local ext = fname and fname:match("%.([^%.]+)$")
						ext = ext and ext:lower()
						local kind = nil
						if ext == "txt" then
							kind = "text"
						elseif ext and BG_IMAGE_EXT[ext] then
							kind = "image"
						end
						local okFile, isFile = pcall(isfile, f)
						if kind and okFile and isFile and not byName[fname] then
							byName[fname] = {kind = kind, path = f}
							table.insert(names, fname)
						end
					end
				end
			end
		end
	end
	if create and not foundFolder then
		pcall(makefolder, DATA_FOLDER)
		pcall(makefolder, base)
		pcall(makefolder, base .. "/backgrounds")
	end
	BG.names, BG.byName = names, byName
	return names
end

function BG.set(name)
	BG.current = name
	pcall(writefile, BG_SAVE_FILE, name)
	if BG.apply then BG.apply() end
end

-- The patched Uhhhhhh source calls this right after its "UI Theme" dropdown,
-- so the "Background" dropdown shows up directly under the themes.
_G.NOTCreateBackgroundUI = function(UI, MainPage)
	local names = BG.scan(true)
	local index = table.find(names, BG.current) or 1
	local select = UI.CreateDropdown(MainPage, "Background", names, index)
	select.Changed:Connect(function(val)
		if names[val] then BG.set(names[val]) end
	end)
	if BG.apply then BG.apply() end
end

