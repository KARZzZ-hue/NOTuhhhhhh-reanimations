	})
	SaveData.NOTTrail = T
	local D = ensureDefaults(SaveData.NOTDance, {
		Enabled = false, Trigger = "Dancing (auto)", Interval = 0.2, Fade = 0.8,
		StartTransparency = 0.4, MaxGhosts = 12, Expand = 0, Material = "Neon",
		Rainbow = false, R = 255, G = 255, B = 255,
	})
	SaveData.NOTDance = D

	local function round2(v) return math.floor(v * 100 + 0.5) / 100 end
	local function indexOf(list, v) return table.find(list, v) or 1 end

	----------------------------------------------------------------
	-- pages
	----------------------------------------------------------------
	local function makePage()
