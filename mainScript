local function ensureDefaults(tbl, defaults)
	if type(tbl) ~= "table" then tbl = {} end
	for k, v in pairs(defaults) do
		if tbl[k] == nil then tbl[k] = v end
	end
	return tbl
end

-- copy only the keys that already exist (and have the same type) from a loaded preset
local function applyInto(target, src)
	if type(src) ~= "table" then return end
	for k, v in pairs(src) do
		if target[k] ~= nil and type(target[k]) == type(v) then target[k] = v end
	end
end

-- the models that make up the player's body (the script's own character, the original one, the camera's)
local function bodyModels()
	local list = {}
	local function add(m)
		if m and m:IsA("Model") and not table.find(list, m) then
			table.insert(list, m)
		end
	end
	add(LocalPlayer.Character)
	add(workspace:FindFirstChild(LocalPlayer.Name))
	local cam = workspace.CurrentCamera
	if cam and cam.CameraSubject and cam.CameraSubject:IsA("Humanoid") then
		add(cam.CameraSubject.Parent)
	end
	return list
end

local function resolveTrailParts(location)
	local logical = LOCATION_GROUPS[location] or {location}
	local models = bodyModels()
	local parts = {}
	for _, lname in ipairs(logical) do
		local aliases = PART_ALIASES[lname]
		if aliases then
			local found = nil
			for _, m in ipairs(models) do
				for _, a in ipairs(aliases) do
					local p = m:FindFirstChild(a)
					if p and p:IsA("BasePart") then
						found = p
						break
					end
				end
				if found then break end
			end
			if found then table.insert(parts, found) end
		end
	end
	return parts
end

-- all visible parts of the avatar (also accessories), used for the ghost fills
local function visibleBodyParts()
	local out, seen = {}, {}
	for _, m in ipairs(bodyModels()) do
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") and not seen[d] and d.Name ~= "HumanoidRootPart"
				and d.Transparency < 0.95 and d.Size.Magnitude > 0.2 then
				seen[d] = true
				out[#out + 1] = d
			end
		end
	end
	return out
end

-- the first body model that actually has something visible (for the outline)
local function visibleBodyModel()
	for _, m in ipairs(bodyModels()) do
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency < 0.95 then
				return m
			end
		end
	end
	return nil
end

-- the client-side root (the fake "(C) ..." rig the script moves) and the server-sided root
-- (the real character that the server sees). With no fake rig only one root exists.
local function findRootParts()
	local function rootOf(m)
		local r = m and m:FindFirstChild("HumanoidRootPart")
		if r and r:IsA("BasePart") then return r end
		return nil
	end
	local fake, real = nil, nil
	local function consider(m)
		if not (m and m:IsA("Model")) then return end
		if m.Name:sub(1, 3) == "(C)" then
			fake = fake or m
		elseif m.Name == LocalPlayer.Name or m == LocalPlayer.Character then
			real = real or m
		end
	end
	consider(LocalPlayer.Character)
	consider(workspace:FindFirstChild(LocalPlayer.Name))
	local cam = workspace.CurrentCamera
	if cam and cam.CameraSubject and cam.CameraSubject:IsA("Humanoid") then
		consider(cam.CameraSubject.Parent)
	end
	if not fake then
		for _, m in ipairs(workspace:GetChildren()) do
			if m:IsA("Model") and m.Name:sub(1, 3) == "(C)" then
				fake = m
				break
			end
		end
	end
	local clientRoot = rootOf(fake) or rootOf(real)
	local serverRoot = rootOf(real)
	if serverRoot == clientRoot then serverRoot = nil end
	return clientRoot, serverRoot
end

local function rainbowSequence(t)
	local kp = table.create(5)
	for i = 0, 4 do
		kp[i + 1] = ColorSequenceKeypoint.new(i / 4, Color3.fromHSV((t * 0.3 + i * 0.2) % 1, 1, 1))
	end
	return ColorSequence.new(kp)
end

local function rainbowColor(t)
	return Color3.fromHSV((t * 0.3) % 1, 1, 1)
end

local function sameParts(a, b)
	if #a ~= #b then return false end
	for i, p in ipairs(a) do
		if b[i] ~= p or not p.Parent then return false end
	end
	return true
end

