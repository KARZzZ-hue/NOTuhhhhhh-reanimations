-- find a folder in the workspace root, ignoring upper/lower case
local function findFolder(name)
	local okDirect, direct = pcall(isfolder, name)
	if okDirect and direct then return name end
	local lower = name:lower()
	local ok, list = pcall(listfiles, "")
	if not ok or type(list) ~= "table" then
		ok, list = pcall(listfiles, ".")
	end
	if ok and type(list) == "table" then
		for _, p in ipairs(list) do
			local n = p:match("([^/\\]+)$")
			if n and n:lower() == lower then
				local okF, isF = pcall(isfolder, p)
				if okF and isF then return p end
			end
		end
	end
	return nil
end

-- copy everything from src into dst (sub folders too). Files that already exist are never overwritten.
local function copyFolder(src, dst, stats)
	if not isfolder(dst) then pcall(makefolder, dst) end
	for _, path in ipairs(listfiles(src)) do
		local name = path:match("([^/\\]+)$")
		if name then
			local target = dst .. "/" .. name
			if isfolder(path) then
				copyFolder(path, target, stats)
			elseif isfile(target) then
				stats.skipped += 1
			else
				local ok = pcall(function() writefile(target, readfile(path)) end)
				if ok then stats.copied += 1 else stats.failed += 1 end
				task.wait()
			end
		end
	end
end

local function injectImportButtons()
	local roots = {CoreGui}
	local okH, hid = pcall(function() return (gethui and gethui()) or (get_hidden_gui and get_hidden_gui()) end)
	if okH and hid then table.insert(roots, 1, hid) end

	-- the main page is the one with the "Back to cool scene" button
	local page
	local deadline = os.clock() + 300
	while not page and os.clock() < deadline do
		for _, root in ipairs(roots) do
			for _, g in ipairs(root:GetChildren()) do
				if g:IsA("ScreenGui") and g.DisplayOrder == 2147483647 and g ~= introGui then
					for _, d in ipairs(g:GetDescendants()) do
						if d:IsA("TextLabel") and d.Text:find("Back to cool scene", 1, true) then
							page = d:FindFirstAncestorWhichIsA("ScrollingFrame")
							break
						end
					end
				end
				if page then break end
			end
			if page then break end
		end
		if not page then task.wait(0.5) end
	end
	if not page then return end

	-- big layout orders keep everything at the very bottom, even if the script adds more items later
	local function container(order, height)
		local c = Instance.new("Frame")
		c.Name = tostring(math.random(1000000, 9000000))
		c.AnchorPoint = Vector2.new(0.5, 0)
		c.Size = UDim2.new(1, 0, 0, height)
		c.BackgroundTransparency = 1
		c.BorderSizePixel = 0
		c.LayoutOrder = order
		c.Parent = page
		return c
	end

	-- separator
	local sepC = container(1000000, 7)
	local sep = Instance.new("Frame")
	sep.AnchorPoint = Vector2.new(0.5, 0.5)
	sep.Position = UDim2.new(0.5, 0, 0.5, 0)
	sep.Size = UDim2.new(1, -8, 0, 1)
	sep.BackgroundColor3 = Color3.new(1, 1, 1)
	sep.BackgroundTransparency = 0.8
	sep.BorderSizePixel = 0
	sep.Parent = sepC

	-- small hint
	local hintC = container(1000001, 32)
	local hint = Instance.new("TextLabel")
	hint.Position = UDim2.new(0, 5, 0, 0)
	hint.Size = UDim2.new(1, -10, 1, 0)
	hint.BackgroundTransparency = 1
	hint.Font = Enum.Font.Code
	hint.TextSize = 11
	hint.TextColor3 = Color3.new(1, 1, 1)
	hint.TextTransparency = 0.35
	hint.TextWrapped = true
	hint.Text = "Copies files into the " .. DATA_FOLDER .. " folder. Existing files are never overwritten. Restart the script afterwards."
	hint.Parent = hintC

	local busy = false
	local function makeButton(order, text, folderName)
		local c = container(order, 40)
		local b = Instance.new("TextButton")
		b.Position = UDim2.new(0, 5, 0, 5)
		b.Size = UDim2.new(1, -10, 1, -10)
		b.BackgroundColor3 = Color3.new(0, 0, 0)
		b.BorderSizePixel = 0
		b.AutoButtonColor = true
		b.Font = Enum.Font.Code
		b.TextSize = 15
		b.TextColor3 = Color3.new(1, 1, 1)
		b.Text = text
		b.Parent = c
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 5)
		corner.Parent = b
		local stroke = Instance.new("UIStroke")
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = Color3.new(1, 1, 1)
		stroke.Thickness = 1
		stroke.Parent = b

		b.Activated:Connect(function()
			if busy then return end
			busy = true
			b.Text = "Working..."
			local msg
			local src = findFolder(folderName)
			if not src then
				msg = folderName .. " folder not found"
			else
				if not isfolder(DATA_FOLDER) then pcall(makefolder, DATA_FOLDER) end
				local stats = {copied = 0, skipped = 0, failed = 0}
				local ok, err = pcall(copyFolder, src, DATA_FOLDER, stats)
				if ok then
					msg = string.format("Copied %d, skipped %d", stats.copied, stats.skipped)
					if stats.failed > 0 then msg ..= string.format(", failed %d", stats.failed) end
				else
					msg = "Import failed (see console)"
					warn("[" .. TITLE .. "] import error: " .. tostring(err))
				end
			end
			b.Text = msg
			notify(msg)
			task.wait(3.5)
			b.Text = text
			busy = false
		end)
		return b
	end

	makeButton(1000002, "Import from " .. SRC_UHHHHHH, SRC_UHHHHHH)
	makeButton(1000003, "Import from " .. SRC_BLAABLAA, SRC_BLAABLAA)
end

