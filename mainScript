-- plain text replace that also matches when the original uses different spacing/indentation.
-- returns the new source and how many places were changed.
local function replaceAll(s, from, to)
	local pat = from:gsub("%p", "%%%0")
	pat = pat:gsub("%s+", "%%s+")
	local rep = to:gsub("%%", "%%%%")
	return s:gsub(pat, rep)
end

