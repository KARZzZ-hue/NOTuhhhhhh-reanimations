--[[
	NOTuhhhhhh reanimations
	Loading screen: the ASCII-art sparkle logo grows into the screen in black and white,
	fades in, rolls in a sine wave, then explodes into static.
	The GUI also gets an animated ASCII background.
	Tap the screen during the intro to skip it.
	After that it loads the Uhhhhhh fork from your link and renames it.

	Original Uhhhhhh code: STEVETHEREALONE, BoredGal (patches), Awes955 (mod).
	Credits stay in the source, point at it if you reuse snippets.
]]

if _G.NOTuhhhhhhReanimationsLoaded or _G.UhhhhhhLoaded then
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "NOTuhhhhhh reanimations",
			Text = "Already running. Rejoin to start it again.",
			Duration = 4,
		})
	end)
	return
end
_G.NOTuhhhhhhReanimationsLoaded = true

local SOURCE_URL = "https://raw.githubusercontent.com/testing734/UhhhhhhModded/refs/heads/main/uhhhhhh%20awes%20fork"
local TITLE = "NOTuhhhhhh reanimations"

-- this script keeps its own data folder (saves, assets, modules, animations...).
-- It has to be exactly as long as "UhhhhhhReanim" (13 characters), because the original code
-- cuts file names out of folder paths by position.
local DATA_FOLDER = "NOTuhhhReanim"
-- folders the two import buttons copy from
local SRC_UHHHHHH = "UhhhhhhReanim"
local SRC_BLAABLAA = "BlaablaaReanim"

-- the explosion flickers a lot. Set to true for a calmer one (slower, dimmer flicker).
local REDUCE_FLASHING = false

local VERSION = "2.0"

-- intro style: Full / Short / Off (changed in Config > Interface, applies on the next start)
local INTRO_FILE = DATA_FOLDER .. "/NOTintro.txt"
local INTRO_STYLES = {"Full", "Short", "Off"}
local INTRO_STYLE = "Full"
pcall(function()
	if isfile(INTRO_FILE) then
		local v = readfile(INTRO_FILE):gsub("%s+", "")
		if table.find(INTRO_STYLES, v) then INTRO_STYLE = v end
	end
end)

local cloneref = cloneref or function(o) return o end
local TweenService = cloneref(game:GetService("TweenService"))
local RunService = cloneref(game:GetService("RunService"))
local TextService = cloneref(game:GetService("TextService"))
local CoreGui = cloneref(game:GetService("CoreGui"))
local StarterGui = cloneref(game:GetService("StarterGui"))
local Players = cloneref(game:GetService("Players"))

local function notify(text)
	pcall(function()
		StarterGui:SetCore("SendNotification", {Title = TITLE, Text = text, Duration = 5})
	end)
end

